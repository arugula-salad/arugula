diff --git a/web/src/shell/ui/shell/frame-tools.tsx b/web/src/shell/ui/shell/frame-tools.tsx
new file mode 100644
index 000000000..765a28709
--- /dev/null
+++ b/web/src/shell/ui/shell/frame-tools.tsx
@@ -0,0 +1,30 @@
+// S47 (#655), spike only: the shell draws its own bell over the kept frame, so
+// the platform page gets no machine data. Commands opens from a key press the
+// frame forwards.
+
+import { useEffect, useState } from "preact/hooks";
+import type { Client } from "../../client";
+import { frameShown, onFrame, restoreFrame } from "../../platform-frame";
+import { openPalette } from "../palette";
+import { AttentionBell } from "./attention-drawer";
+
+export function FrameTools({ client }: { client: Client }) {
+  const [, tick] = useState(0);
+  useEffect(() => {
+    const fn = () => tick((t) => t + 1);
+    const off = onFrame(fn);
+    const commands = () => openPalette(client, false);
+    addEventListener("s47-commands", commands);
+    restoreFrame();
+    return () => {
+      off();
+      removeEventListener("s47-commands", commands);
+    };
+  }, []);
+  if (!frameShown()) return null;
+  return (
+    <div class="s47-frame-tools" data-frame-tools>
+      <AttentionBell client={client} />
+    </div>
+  );
+}

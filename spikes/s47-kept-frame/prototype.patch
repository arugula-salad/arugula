diff --git a/web/src/shell/platform-frame.ts b/web/src/shell/platform-frame.ts
new file mode 100644
index 000000000..32b485a97
--- /dev/null
+++ b/web/src/shell/platform-frame.ts
@@ -0,0 +1,114 @@
+// S47 (#655), spike only: the shell holds the platform page in a kept frame.
+// Control's page stays the top page, so the panes never unload. `?noframe`
+// turns it off, to measure today's behaviour on the same build. `?framehide=
+// visibility` hides the frame by visibility rather than display.
+
+import { platformOrigin } from "./platform-links";
+
+const query = new URLSearchParams(location.search);
+const off = query.has("noframe");
+const hideBy = query.get("framehide") === "visibility" ? "visibility" : "display";
+
+let frame: HTMLIFrameElement | null = null;
+let shown = false;
+let path = "/";
+const listeners = new Set<() => void>();
+const tell = () => listeners.forEach((fn) => fn());
+
+export const frameOn = () => !off && !!platformOrigin();
+export const frameShown = () => shown;
+export const framePath = () => path;
+export function onFrame(fn: () => void) {
+  listeners.add(fn);
+  return () => void listeners.delete(fn);
+}
+
+/** What the address bar says: `?at=` is the frame's path. */
+function address(at: string | null, push: boolean) {
+  const u = new URL(location.href);
+  if (at) u.searchParams.set("at", at);
+  else u.searchParams.delete("at");
+  history[push ? "pushState" : "replaceState"](null, "", u);
+}
+
+function place() {
+  if (!frame) return;
+  const rail = document.querySelector(".ws-rail")?.getBoundingClientRect();
+  frame.style.left = `${rail?.right ?? 0}px`;
+  frame.style.width = `${innerWidth - (rail?.right ?? 0)}px`;
+  if (hideBy === "display") frame.style.display = shown ? "block" : "none";
+  else {
+    frame.style.visibility = shown ? "visible" : "hidden";
+    frame.style.pointerEvents = shown ? "auto" : "none";
+  }
+}
+
+function ensure(to: string) {
+  if (frame) return false;
+  frame = document.createElement("iframe");
+  frame.dataset.platformFrame = "";
+  frame.title = "Projects";
+  frame.setAttribute("allow", "clipboard-write; camera; microphone; display-capture; fullscreen");
+  // No allow-top-navigation of either kind: after any click in it, an unsandboxed
+  // frame can move the whole tab (measured). Leaving goes through the shell.
+  if (!query.has("nosandbox")) frame.setAttribute("sandbox", "allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads");
+  frame.style.cssText = "position:fixed;top:0;bottom:0;height:100%;border:0;z-index:46;background:var(--bg)";
+  frame.src = `${platformOrigin()}${to}`;
+  document.body.append(frame);
+  return true;
+}
+
+/** Show the frame at `to`. A path it's already on moves nothing. */
+export function showPlatform(to: string, push = true) {
+  const fresh = ensure(to);
+  if (!fresh && to !== "/?back" && to !== path) frame!.contentWindow?.postMessage({ go: to }, platformOrigin()!);
+  if (to !== "/?back") path = to;
+  const was = shown;
+  shown = true;
+  place();
+  if (!was) address(path, push);
+  frame!.focus();
+  tell();
+}
+
+export function hidePlatform(push = true) {
+  if (!shown) return;
+  shown = false;
+  place();
+  address(null, push);
+  tell();
+}
+
+// The frame says where it is, and asks for the two things only the shell has.
+addEventListener("message", (e) => {
+  if (!frame || e.source !== frame.contentWindow || e.origin !== platformOrigin()) return;
+  const d = e.data as { at?: unknown; commands?: unknown };
+  if (typeof d?.at === "string" && d.at.startsWith("/") && !d.at.startsWith("//")) {
+    path = d.at;
+    if (shown) address(path, false);
+    tell();
+  }
+  if (d?.commands === true) dispatchEvent(new CustomEvent("s47-commands"));
+});
+
+// A rail item that isn't the platform page's leaves it. Back and Forward: the
+// address says whether the frame shows.
+addEventListener("click", (e) => {
+  const t = e.target as HTMLElement;
+  if (!shown || !t.closest?.(".ws-rail")) return;
+  if (!t.closest("[data-open-projects],[data-open-chat],[data-open-settings]")) hidePlatform();
+}, true);
+addEventListener("hashchange", () => shown && hidePlatform(false));
+addEventListener("popstate", () => {
+  const at = new URLSearchParams(location.search).get("at");
+  if (at && at.startsWith("/") && !at.startsWith("//")) {
+    if (!shown) showPlatform(at, false);
+  } else hidePlatform(false);
+});
+addEventListener("resize", place);
+
+/** A reload with `?at=` comes back to the frame. */
+export function restoreFrame() {
+  const at = query.get("at");
+  if (frameOn() && at && at.startsWith("/") && !at.startsWith("//")) showPlatform(at, false);
+}

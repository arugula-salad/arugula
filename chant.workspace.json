{
  "name": "arugula",
  "schema": 1,
  "minReader": "0.108.0",
  "members": [
    {
      "name": "daemon",
      "dir": "crates/daemon",
      "kind": "other",
      "because": "a Rust crate, arugulad: owns the terminals and serves the API, the web client and the editors' socket (the VS Code extension lives in src/editor/ext)",
      "outputs": ["arugulad", "editor-socket"],
      "links": [
        { "member": "web", "output": "dist" },
        { "member": "mux", "output": "crate" },
        { "member": "core", "output": "crate" },
        { "member": "vt", "output": "crate" },
        { "member": "proto", "output": "crate" },
        { "member": "control-wire", "output": "crate" },
        { "member": "e2e", "output": "crate" }
      ]
    },
    {
      "name": "cli",
      "dir": "crates/cli",
      "kind": "other",
      "because": "a Rust crate, the arugula command: drives arugulad over its API",
      "outputs": ["arugula"],
      "links": [
        { "member": "proto", "output": "crate" },
        { "member": "core", "output": "crate" },
        { "member": "control-wire", "output": "crate" },
        { "member": "e2e", "output": "crate" }
      ]
    },
    {
      "name": "web",
      "dir": "web",
      "kind": "other",

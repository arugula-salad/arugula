      "links": [
        { "member": "core", "output": "crate" },
        { "member": "proto", "output": "crate" },
        { "member": "vt", "output": "crate" }
      ]
    },
    {
      "name": "core",
      "dir": "crates/core",
      "kind": "other",
      "because": "a Rust library crate: the multiplexer's state, sessions, tabs and panes, without PTYs or networking",
      "outputs": ["crate"]
    },
    {
      "name": "vt",
      "dir": "crates/vt",
      "kind": "other",

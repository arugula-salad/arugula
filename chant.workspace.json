{
  "name": "arugula",
  "schema": 1,
  "minReader": "0.108.0",
  "members": [],
  "records": [{ "kind": "docs/decisions/decision.kind.mjs" }],
  "writeScope": {
    "agent": { "records": { "decision": ["new", "review"] } }
  },
  "ci": {
    "green": {
      "branch": "main",
      "window": "24h",
      "phases": {
        "lint": ["lint", "changes", "suite-changed"],
        "build": { "runs": ["build", "static", "clippy"], "skipped": "pass" },
        "test": { "runs": ["test"], "skipped": "pass" },
        "e2e": { "runs": ["e2e*"], "skipped": "pass" },
        "macos": { "runs": ["macos*"], "skipped": "pass" },
        "windows": { "runs": ["workspace", "desktop"], "skipped": "pass" }
      },
      "require": ["lint", "build", "test", "e2e", "macos", "windows"]
    }
  }
}

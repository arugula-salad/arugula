      "outputs": ["dist"],
      "links": [{ "member": "proto", "output": "ts" }],
      "generated": [
        {
          "path": "src/proto.gen.ts",
          "generator": "just proto-ts",
          "sources": ["crates/proto/src"]
        }
      ]
    },
    {
      "name": "control",
      "dir": "crates/control",
      "kind": "other",
      "because": "a Rust crate, arugula-control: accounts, devices, the directory and the relay, serving the web client",
      "outputs": ["arugula-control"],
      "links": [
        { "member": "web", "output": "dist" },
        { "member": "core", "output": "crate" },
        { "member": "control-wire", "output": "crate" },
        { "member": "e2e", "output": "crate" }
      ]
    },
    {
      "name": "desktop",
      "dir": "crates/desktop",
      "kind": "other",
      "because": "a Tauri app, its own Cargo workspace: carries arugulad and arugula as sidecars and installs the daemon on first start",
      "outputs": ["app"],
      "links": [
        { "member": "daemon", "output": "arugulad" },
        { "member": "cli", "output": "arugula" },
        { "member": "proto", "output": "crate" }
      ],
      "generated": [
        {
          "path": "THIRD_PARTY.md",
          "generator": "../../scripts/notices",
          "sources": ["scripts/notices", "about.hbs", "crates/desktop/about.toml", "crates/desktop/Cargo.lock"]
        }
      ]
    },
    {
      "name": "mux",
      "dir": "crates/mux",
      "kind": "other",
      "because": "a Rust library crate: the daemon's core (state directory, ACL, panes, providers)",

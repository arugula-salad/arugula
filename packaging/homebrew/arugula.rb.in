# The Arugula formula, which each daemon release commits to the
# arugula-salad/homebrew-tap repo through chant's homebrew target
# (release/daemon/chant.config.ts). Don't edit the copy there.
# `scripts/release formula` puts the version in the tarballs' names, and
# chant fills in the version, each tarball's URL and its SHA-256.
class Arugula < Formula
  desc "Terminal multiplexer whose sessions outlive the window, the daemon and the reboot"
  homepage "https://arugula.io"
  version "{{version}}"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_intel do
      url "{{url:arugula-@VERSION@-x86_64-apple-darwin.tar.gz}}"
      sha256 "{{sha256:arugula-@VERSION@-x86_64-apple-darwin.tar.gz}}"
    end
    on_arm do
      url "{{url:arugula-@VERSION@-aarch64-apple-darwin.tar.gz}}"
      sha256 "{{sha256:arugula-@VERSION@-aarch64-apple-darwin.tar.gz}}"
    end
  end

  on_linux do
    on_intel do
      url "{{url:arugula-@VERSION@-x86_64-unknown-linux-musl.tar.gz}}"
      sha256 "{{sha256:arugula-@VERSION@-x86_64-unknown-linux-musl.tar.gz}}"
    end
    on_arm do
      url "{{url:arugula-@VERSION@-aarch64-unknown-linux-musl.tar.gz}}"
      sha256 "{{sha256:arugula-@VERSION@-aarch64-unknown-linux-musl.tar.gz}}"
    end
  end

  def install
    bin.install "arugulad", "arugula"
  end

  def caveats
    <<~EOS
      Start the daemon as a service (a launchd agent on macOS, a systemd
      user unit on Linux), and again after each upgrade:
        arugulad install
      It copies itself to ~/.local/bin, runs from there, and prints the
      next steps: where to open it, its logs, your phone (Tailscale) and
      Arugula control. Then, for Claude Code:
        claude mcp add arugula -- arugula mcp
      Docs: https://arugula.io/#install
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/arugulad --version")
  end
end

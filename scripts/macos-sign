#!/bin/sh
# macos-sign app PATH.app | dmg PATH.dmg: sign with the Developer ID,
# notarize and staple (#177). Needs these secrets in the environment:
#
#   APPLE_CERTIFICATE           the Developer ID Application certificate
#                               and key, a base64 .p12
#   APPLE_CERTIFICATE_PASSWORD  its password
#   APPLE_SIGNING_IDENTITY      e.g. "Developer ID Application: Name (TEAMID)"
#   APPLE_ID, APPLE_PASSWORD (an app-specific password), APPLE_TEAM_ID
#                               for notarytool
#
# Without APPLE_CERTIFICATE it says so and leaves the ad-hoc signature
# (exit 0): releases stay unsigned until there's a Developer ID.
#
# It signs with rcodesign (apple-codesign, which Tauri builds on), from the
# certificate and key directly: no keychain. codesign through a keychain of
# our own failed on the runner VMs with errSecInternalComponent once Tauri
# had used its own (app-v0.27.1 to 0.27.3). rcodesign comes from PATH, or a
# pinned release is fetched and checked.
set -eu
what=$1
path=$2
[ -e "$path" ] || { echo "macos-sign: no $path" >&2; exit 2; }
if [ -z "${APPLE_CERTIFICATE:-}" ]; then
  echo "macos-sign: skipped for $(basename "$path"): the APPLE_CERTIFICATE secret isn't set (#177); it stays ad-hoc signed"
  exit 0
fi
for v in APPLE_CERTIFICATE_PASSWORD APPLE_SIGNING_IDENTITY APPLE_ID APPLE_PASSWORD APPLE_TEAM_ID; do
  eval "[ -n \"\${$v:-}\" ]" || { echo "macos-sign: APPLE_CERTIFICATE is set but $v isn't" >&2; exit 1; }
done

# The hardened runtime refuses the microphone (a lent device's record_audio,
# S33) to an app without the entitlement: tauri.conf.json's macOS
# "entitlements" (app 0.27.4 shipped without it).
mic() {
  codesign -d --entitlements - "$1" 2>/dev/null | grep -q com.apple.security.device.audio-input ||
    { echo "macos-sign: $(basename "$1") has no microphone entitlement (crates/desktop/macos/entitlements.plist)" >&2; exit 1; }
}

# Tauri's bundler signs, notarizes and staples the app itself when these
# secrets are set (tauri-macos-sign reads the same APPLE_* variables), so an
# app that already carries our identity and a ticket only needs checking.
if [ "$what" = app ] &&
  codesign -dvv "$path" 2>&1 | grep -qxF "Authority=$APPLE_SIGNING_IDENTITY" &&
  xcrun stapler validate "$path" >/dev/null 2>&1; then
  codesign --verify --deep --strict "$path"
  mic "$path"
  spctl --assess --type execute -vv "$path"
  echo "macos-sign: $(basename "$path") was already signed, notarized and stapled by the bundler"
  exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
umask 077

rcodesign=$(command -v rcodesign || true)
if [ -z "$rcodesign" ]; then
  v=0.29.0 sha=d98372d5524226ccf9dc0eda03d4e4f5826182dabb2fc3f2bd303ed9113a748d
  curl -fsSL -o "$tmp/rcodesign.tgz" \
    "https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign%2F$v/apple-codesign-$v-macos-universal.tar.gz"
  echo "$sha  $tmp/rcodesign.tgz" | shasum -a 256 -c >/dev/null
  tar -xzf "$tmp/rcodesign.tgz" -C "$tmp"
  rcodesign=$(find "$tmp" -name rcodesign -type f | head -1)
fi

# The certificate and key on their own: the .p12 also carries Apple's G2
# intermediate, which rcodesign would otherwise take for the signer.
printf '%s' "$APPLE_CERTIFICATE" | base64 --decode >"$tmp/cert.p12"
printf '%s' "$APPLE_CERTIFICATE_PASSWORD" >"$tmp/pass"
openssl pkcs12 -in "$tmp/cert.p12" -passin "file:$tmp/pass" -clcerts -nokeys -out "$tmp/cert.pem"
openssl pkcs12 -in "$tmp/cert.p12" -passin "file:$tmp/pass" -nocerts -nodes -out "$tmp/key.pem"

sign() { "$rcodesign" sign --pem-file "$tmp/key.pem" --pem-file "$tmp/cert.pem" --for-notarization "$@"; }
notarize() {
  xcrun notarytool submit "$1" --apple-id "$APPLE_ID" --password "$APPLE_PASSWORD" --team-id "$APPLE_TEAM_ID" --wait
}

case "$what" in
  app)
    # Inside out: the sidecars, then the app.
    for f in "$path"/Contents/MacOS/*; do
      [ "$(basename "$f")" = arugula-desktop ] || sign --code-signature-flags runtime "$f"
    done
    sign --code-signature-flags runtime --entitlements-xml-file "$(dirname "$0")/../crates/desktop/macos/entitlements.plist" "$path"
    codesign --verify --deep --strict "$path"
    mic "$path"
    ditto -c -k --keepParent "$path" "$tmp/notarize.zip"
    notarize "$tmp/notarize.zip"
    xcrun stapler staple "$path"
    spctl --assess --type execute -vv "$path"
    ;;
  dmg)
    sign "$path"
    notarize "$path"
    xcrun stapler staple "$path"
    spctl --assess --type open --context context:primary-signature -vv "$path"
    ;;
  *) echo "macos-sign: app or dmg" >&2; exit 2 ;;
esac
echo "macos-sign: $(basename "$path") is signed, notarized and stapled"

#!/usr/bin/env bash
# Could this push behave differently on macOS? check.yml's macos job asks
# first, so a docs-, site- or testnet-only push doesn't wait on
# GitHub's macOS runner. main runs it on every push the merge queue hasn't
# already passed (scripts/queue-tested), and on its nightly full run. The paths
# are the workspaces, plus what the macOS job also runs: the web UI
# (the WebKit specs, and the daemon embeds it), the justfile, mise and
# nextest's config.
#
#   scripts/macos-changed [BEFORE]
#
# See scripts/changed for BEFORE and the exit status.
if [ "${GITHUB_REF:-}" = refs/heads/main ]; then
  if "$(dirname "$0")/queue-tested"; then
    echo "the merge queue passed this commit: skipping macOS"
    exit 1
  fi
  echo "main: running it"
  exit 0
fi
exec "$(dirname "$0")/changed" "macOS" "${1:-}" \
  crates Cargo.toml Cargo.lock rust-toolchain.toml \
  web justfile .mise.toml .config/nextest.toml .github/workflows/check.yml scripts/macos-changed scripts/changed

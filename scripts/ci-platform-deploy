#!/usr/bin/env bash
# Deploys control's platform from a release tag (M140, #1157): release.yml's
# `platform` job runs it, before the hub's `control` job. `just
# platform-deploy` is the same deploy from a laptop, for hotfixes.
#
#   ci-platform-deploy deploy TAG DIR   deploy DIR's arugula-platform (x86_64
#                                       musl, `just static`) as
#                                       packaging/platform's image, labelled
#                                       TAG, then `check` it
#   ci-platform-deploy check TAG        every machine runs TAG's image with
#                                       its health check passing (read-only)
#
# Until the app exists there's nothing to deploy: without FLY_API_TOKEN (a
# deploy token for arugula-platform, which can only be made once the app
# exists, kept as the repository secret FLY_PLATFORM_API_TOKEN) `deploy`
# says so and succeeds, so the hub's deploy goes on. The platform has no
# public address, so the check is Fly's own: its machine checks
# (/platform.json on the private network). Like ci-control-deploy, it
# leaves a newer release alone, and calls `flyctl`, not `fly`.
set -euo pipefail
cd "$(dirname "$0")/.."
toml=packaging/platform/fly.toml
app=$(sed -n 's/^app = "\(.*\)"/\1/p' "$toml")
[ -n "$app" ] || { echo "no app in $toml" >&2; exit 1; }

# The image label each of the app's machines runs, one a line.
running() {
  flyctl status -a "$app" --json |
    jq -r '.Machines[] | select(.config.metadata.fly_process_group == "app") | .image_ref.tag'
}

# Once: every machine is started on TAG's image with its checks passing.
# Says what it saw when not.
check_once() {
  local tag=$1 st
  st=$(flyctl status -a "$app" --json) || { echo "fly status failed"; return 1; }
  if ! jq -e --arg t "$tag" '
      [.Machines[] | select(.config.metadata.fly_process_group == "app")] as $m
      | ($m | length) > 0
        and all($m[]; .state == "started" and .image_ref.tag == $t
                      and all(.checks[]?; .status == "passing"))' <<<"$st" >/dev/null; then
    jq -r '.Machines[] | "machine \(.id): \(.state), image \(.image_ref.tag), checks \([.checks[]?.status] | join(","))"' <<<"$st"
    return 1
  fi
}

check() {
  local tag=${1:?usage: ci-platform-deploy check TAG}
  for _ in $(seq 1 12); do
    if check_once "$tag"; then
      echo "$app runs $tag"
      return 0
    fi
    sleep 10
  done
  echo "::error::$app isn't running $tag after its deploy (above: what fly status said)"
  return 1
}

deploy() {
  local tag=${1:?usage: ci-platform-deploy deploy TAG DIR} dir=${2:?usage: ci-platform-deploy deploy TAG DIR}
  if [ -z "${FLY_API_TOKEN:-}" ]; then
    echo "::notice::FLY_PLATFORM_API_TOKEN isn't set: $app wasn't deployed (until the app exists and has a deploy token, the platform runs inside the hub). docs/control-ops.md, \"The platform\"."
    return 0
  fi
  local now
  now=$(running | sort -V | tail -n 1)
  if [[ $now =~ ^v[0-9] ]] && [ "$now" != "$tag" ] &&
    [ "$(printf '%s\n%s\n' "$tag" "$now" | sort -V | tail -n 1)" = "$now" ]; then
    echo "::notice::$app already runs $now, newer than $tag: not deployed"
    return 0
  fi
  local ctx
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  cp "$dir/arugula-platform" packaging/platform/Dockerfile "$toml" "$ctx"/
  chmod +x "$ctx/arugula-platform"
  (cd "$ctx" && flyctl deploy --local-only --ha=false --image-label "$tag")
  check "$tag"
}

case ${1:-} in
  deploy) shift; deploy "$@" ;;
  check) shift; check "$@" ;;
  *) sed -n '5,10p' "$0" >&2; exit 2 ;;
esac

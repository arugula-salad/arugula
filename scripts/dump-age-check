#!/usr/bin/env -S python3 -I
"""The platform dump's age check (part of Arugula #867): an alert when the
newest nightly dump of the platform's Postgres in R2 is too old.

The `platform-dump` machine in arugula-platform writes `platform-pg/latest.json`
beside each dump (docs/control-ops.md, "The nightly dump"). This reads it,
read-only, and when its `at` is more than ARUGULA_DUMP_AGE_LIMIT_HOURS (26)
old, or it can't be read at all, opens a native issue labelled `backup`,
assigned to ARUGULA_DUMP_AGE_ASSIGNEE, or comments on the one already open
(once a day). A check that can't see the dump alerts too: the dump's schedule
once stopped for 18 days without a word. Under the limit it prints the
newest dump and its age, and exits 0.

    scripts/dump-age-check              # check, and alert if it's old
    scripts/dump-age-check --dry-run    # print what it would file; write nothing
    scripts/dump-age-check --install    # the hourly systemd user timer, on geek

R2's endpoint, bucket and keys come from Infisical at each run (`arugula`
prod, /illogical/control, as scripts/platform-restore-drill reads them) and
are only ever in this process's environment. Needs infisical logged in, the
aws CLI and, to alert, `arugula login`. Set INFISICAL_PROJECT_ID when it runs
outside a checkout with .infisical.json (the timer does: --install writes the
one in its environment to the settings file).
"""

import argparse
import datetime as dt
import json
import os
import pathlib
import shutil
import subprocess
import sys


def env(name, default):
    return os.environ.get(name) or default


def log(*a):
    print(*a, file=sys.stderr)


def infisical(names):
    """The first of Infisical's `names` that's set, or None."""
    for name in names:
        cmd = ["infisical", "secrets", "get", name, "--env", "prod", "--path", "/illogical/control", "--plain", "--silent"]
        if os.environ.get("INFISICAL_PROJECT_ID"):
            cmd += ["--projectId", os.environ["INFISICAL_PROJECT_ID"]]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return None


def setting(var, *names):
    """The environment's `var`, else the first of Infisical's `names`."""
    v = os.environ.get(var) or infisical(names)
    if not v:
        raise RuntimeError(f"no {var} in the environment, and Infisical has none of: {', '.join(names)}")
    return v


def newest_record():
    """platform-pg/latest.json, as the dump job wrote it."""
    endpoint = setting("ARUGULA_DRILL_ENDPOINT", "ARUGULA_DUMP_ENDPOINT", "LITESTREAM_ENDPOINT")
    bucket = setting("ARUGULA_DRILL_BUCKET", "ARUGULA_DUMP_BUCKET", "LITESTREAM_BUCKET")
    prefix = env("ARUGULA_DRILL_PREFIX", "platform-pg")
    keys = {
        "AWS_ACCESS_KEY_ID": setting("ARUGULA_DRILL_ACCESS_KEY_ID", "ARUGULA_DUMP_ACCESS_KEY_ID", "LITESTREAM_ACCESS_KEY_ID"),
        "AWS_SECRET_ACCESS_KEY": setting(
            "ARUGULA_DRILL_SECRET_ACCESS_KEY", "ARUGULA_DUMP_SECRET_ACCESS_KEY", "LITESTREAM_SECRET_ACCESS_KEY"
        ),
        "AWS_REGION": "auto",
        "AWS_DEFAULT_REGION": "auto",
    }
    r = subprocess.run(
        ["aws", "--endpoint-url", endpoint, "s3", "cp", "--only-show-errors", f"s3://{bucket}/{prefix}/latest.json", "-"],
        capture_output=True, text=True, timeout=120, env={**os.environ, **keys},
    )
    if r.returncode != 0:
        raise RuntimeError(f"couldn't read {prefix}/latest.json from R2: {r.stderr.strip()[:300]}")
    return json.loads(r.stdout)


def taken(record):
    """The record's `at` (2026-11-11T035142Z) as a UTC time."""
    return dt.datetime.strptime(record["at"], "%Y-%m-%dT%H%M%SZ").replace(tzinfo=dt.timezone.utc)


def alert(args, title, body, state):
    body = (
        f"{body}\n\nFrom `scripts/dump-age-check` on an hourly timer (docs/launch-runbook.md, \"The platform's "
        "nightly dump\"). What to do: that section. Close this once a dump has landed; the next old one opens another."
    )
    project = env("ARUGULA_DUMP_AGE_PROJECT", "")
    where = ["--native"] + (["--project", project] if project else [])
    if args.dry_run:
        print(f"\n--dry-run: would alert: {title}\n\n{body}")
        return
    listed = subprocess.run(
        ["arugula", "issue", "list", *where, "--state", "open", "--label", "backup", "--json"],
        capture_output=True, text=True, timeout=60,
    )
    open_issues = json.loads(listed.stdout or "{}").get("issues", []) if listed.returncode == 0 else []
    stamp = state / "alerted"
    today = dt.date.today().isoformat()
    if open_issues:
        if stamp.exists() and stamp.read_text().strip() == today:
            log("dump-age-check: old; already said so today")
            return
        n = f"#{open_issues[0]['number']}"
        cmd = ["arugula", "issue", "comment", *where, n, f"**{title}**\n\n{body}"]
    else:
        assignee = env("ARUGULA_DUMP_AGE_ASSIGNEE", "jhgaylor")
        cmd = ["arugula", "issue", "new", *where, "--title", title, "--body", body, "--label", "backup", "--assignee", assignee]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        log(f"dump-age-check: alerting failed: {r.stderr.strip()[:300]}")
        sys.exit(3)
    state.mkdir(parents=True, exist_ok=True)
    stamp.write_text(today)
    log(f"dump-age-check: alerted: {title}")


def check(args):
    limit = float(env("ARUGULA_DUMP_AGE_LIMIT_HOURS", "26"))
    state = pathlib.Path(
        env("ARUGULA_DUMP_AGE_STATE", str(pathlib.Path(env("XDG_STATE_HOME", str(pathlib.Path.home() / ".local/state"))) / "arugula-dump-age"))
    )
    try:
        record = newest_record()
        at = taken(record)
    except Exception as e:  # noqa: BLE001
        alert(args, "Platform dump: can't see the newest dump", f"The age check couldn't read the newest dump's record: {e}", state)
        return 1
    hours = (dt.datetime.now(dt.timezone.utc) - at).total_seconds() / 3600
    line = f"newest platform dump {record.get('object', '?')}, taken {record['at']}, {hours:.1f} h old (limit {limit:g} h)"
    print(line)
    if hours <= limit:
        return 0
    alert(
        args,
        f"Platform dump: the newest is {hours:.0f} h old",
        f"The newest dump of the platform's Postgres in R2 is {hours:.0f} hours old, past the {limit:g} h limit: "
        f"the nightly dump has stopped.\n\n{line}",
        state,
    )
    return 1


UNIT = """[Unit]
Description=Arugula's platform dump age check (docs/launch-runbook.md)

[Service]
Type=oneshot
Environment=PATH={path}
EnvironmentFile=-%h/.config/arugula-dump-age/env
ExecStart={script}
"""

TIMER = """[Unit]
Description=Arugula's platform dump age check, hourly

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
"""


def install():
    home = pathlib.Path.home()
    share = home / ".local/share/arugula-dump-age"
    share.mkdir(parents=True, exist_ok=True)
    script = share / "dump-age-check"
    shutil.copy2(__file__, script)
    script.chmod(0o755)
    units = home / ".config/systemd/user"
    units.mkdir(parents=True, exist_ok=True)
    tools = ["infisical", "aws", "arugula"]
    path = os.pathsep.join(
        dict.fromkeys(
            [str(pathlib.Path(shutil.which(t)).parent) for t in tools if shutil.which(t)] + ["/usr/local/bin", "/usr/bin", "/bin"]
        )
    )
    (units / "arugula-dump-age-check.service").write_text(UNIT.format(path=path, script=script))
    (units / "arugula-dump-age-check.timer").write_text(TIMER)
    conf = home / ".config/arugula-dump-age/env"
    if not conf.exists():
        conf.parent.mkdir(parents=True, exist_ok=True)
        conf.write_text(
            "# The platform dump age check's settings (scripts/dump-age-check). Not secrets.\n"
            "ARUGULA_DUMP_AGE_LIMIT_HOURS=26\nARUGULA_DUMP_AGE_PROJECT=\nARUGULA_DUMP_AGE_ASSIGNEE=jhgaylor\n"
            f"INFISICAL_PROJECT_ID={os.environ.get('INFISICAL_PROJECT_ID', '')}\n"
        )
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "arugula-dump-age-check.timer"], check=True)
    print(f"installed {script}, arugula-dump-age-check.timer (hourly); settings in {conf}")


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--dry-run", action="store_true", help="print the check and what it would file; write nothing")
    p.add_argument("--install", action="store_true", help="install the hourly systemd user timer")
    args = p.parse_args()
    if args.install:
        install()
        return 0
    return check(args)


if __name__ == "__main__":
    sys.exit(main())

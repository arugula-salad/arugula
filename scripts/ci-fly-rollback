#!/usr/bin/env bash
# Puts a Fly app back on the release it ran before, when a deploy left it
# unhealthy (#723). flyctl stops a rolling deploy at a failed health check, but it
# never goes back, so without this a bad release stays up until someone notices.
# scripts/ci-control-deploy and scripts/ci-platform-deploy run it.
#
#   ci-fly-rollback prior APP
#       the image every one of APP's machines runs now, as a full reference, or
#       nothing when they don't all run one image, or none runs. Read-only.
#   ci-fly-rollback restore APP REF TOML [FLYCTL_DEPLOY_ARG...]
#       deploys REF. It says what it did in the job's log and summary. It doesn't
#       check the result: the caller does, with its own check.
#
# Going back can fail too: an older build refuses a migration that isn't additive
# (crates/platform/src/db/migrate_tests.rs), and then the app needs a person. The
# callers say so.
set -euo pipefail

summary() {
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || printf '%s\n' "$@" >>"$GITHUB_STEP_SUMMARY"
}

prior() {
  local app=${1:?usage: ci-fly-rollback prior APP} refs
  refs=$(flyctl status -a "$app" --json |
    jq -r '.Machines[] | select(.config.metadata.fly_process_group == "app") | "\(.image_ref.registry)/\(.image_ref.repository):\(.image_ref.tag)"' | sort -u)
  [ -n "$refs" ] || return 0
  [ "$(wc -l <<<"$refs")" = 1 ] || return 0
  echo "$refs"
}

restore() {
  local app=${1:?usage: ci-fly-rollback restore APP REF TOML [ARG...]}
  local ref=${2:?usage: ci-fly-rollback restore APP REF TOML [ARG...]}
  local toml=${3:?usage: ci-fly-rollback restore APP REF TOML [ARG...]}
  shift 3
  echo "::warning title=Rolling back::$app is going back to $ref"
  summary "### $app: rolling back" "" "Its new release didn't come up healthy, so it's going back to \`$ref\`."
  flyctl deploy -a "$app" --config "$toml" --image "$ref" --ha=false "$@"
}

case ${1:-} in
  prior) shift; prior "$@" ;;
  restore) shift; restore "$@" ;;
  *) sed -n '7,12p' "$0" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# Deploys the hosted control from a release tag (M133, #1129): release.yml's
# `control` job runs it. `just control-deploy` is the same deploy from a
# laptop, for hotfixes.
#
#   ci-control-deploy deploy TAG DIR   deploy DIR's arugula-control
#                                      (x86_64 musl, `just static`) as
#                                      packaging/control's image, labelled
#                                      TAG, then `check` it; unless nothing
#                                      the hub is built from changed since
#                                      the release it runs (`check` that one)
#   ci-control-deploy check TAG        control answers /control.json, and
#                                      every machine runs TAG's image with
#                                      its health check passing (read-only)
#
# The image is built here, as `just control-deploy` builds it (fly deploy
# --local-only, so it needs Docker). `deploy` leaves a newer release alone:
# re-running an old tag's job doesn't take control back a version.
#
# The hub holds every relayed terminal, and a deploy drops them all, so a
# tag deploys it only when something it's built from changed since the
# release it runs: DIR/hub-inputs (the `linux` job's `scripts/ci-hub-changed
# inputs`) compared between that release's tag and TAG (`scripts/ci-hub-changed
# diff`). Version numbers alone don't count. It deploys whenever it can't
# tell: no hub-inputs, machines on different images, a hotfix's image
# (`deployment-...`), a tag it can't fetch. ARUGULA_HUB_DEPLOY=always (the
# repository variable of that name, in release.yml) deploys it anyway. A
# skip says so in the job's summary and checks the release the hub runs. So
# the hub's version can be older than the tag's: `fly releases -a
# illogical-control` lists only the tags that deployed it.
#
# The app and its URL come from packaging/control/fly.toml; Fly's token is
# FLY_API_TOKEN, a deploy token for the app. It calls `flyctl`, not `fly`:
# setup-flyctl's tarball has no `fly` link (v0.53.0's deploy died on it).
set -euo pipefail
cd "$(dirname "$0")/.."
toml=packaging/control/fly.toml
app=$(sed -n 's/^app = "\(.*\)"/\1/p' "$toml")
url=$(sed -n 's/^ *ARUGULA_CONTROL_URL = "\(.*\)"/\1/p' "$toml")
[ -n "$app" ] && [ -n "$url" ] || { echo "no app or ARUGULA_CONTROL_URL in $toml" >&2; exit 1; }

# The image label each of the app's machines runs, one a line.
running() {
  flyctl status -a "$app" --json |
    jq -r '.Machines[] | select(.config.metadata.fly_process_group == "app") | .image_ref.tag'
}

# Once: control.json answers as control, and every machine is started on
# TAG's image with its checks passing. Says what it saw when not.
check_once() {
  local tag=$1 st
  st=$(flyctl status -a "$app" --json) || { echo "fly status failed"; return 1; }
  if ! jq -e --arg t "$tag" '
      [.Machines[] | select(.config.metadata.fly_process_group == "app")] as $m
      | ($m | length) > 0
        and all($m[]; .state == "started" and .image_ref.tag == $t
                      and all(.checks[]?; .status == "passing"))' <<<"$st" >/dev/null; then
    jq -r '.Machines[] | "machine \(.id): \(.state), image \(.image_ref.tag), checks \([.checks[]?.status] | join(","))"' <<<"$st"
    return 1
  fi
  # Fly's health check (fly.toml), from outside, through the proxy.
  curl -fsS --max-time 10 "$url/control.json" | jq -e '.control == true' >/dev/null ||
    { echo "$url/control.json didn't answer as control"; return 1; }
}

# Lines for the job's summary (GitHub's step summary), when there is one.
summary() {
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || printf '%s\n' "$@" >>"$GITHUB_STEP_SUMMARY"
}

# A tag's commit here, fetched (alone, as a shallow checkout fetches) if
# it isn't.
have_tag() {
  git rev-parse -q --verify "refs/tags/$1^{commit}" >/dev/null ||
    git fetch -q --no-tags --depth=1 origin "+refs/tags/$1:refs/tags/$1" 2>/dev/null
}

# unchanged TAG DIR: succeeds when the hub needn't deploy for TAG, nothing
# it's built from having changed since the release it runs; fails when it
# must, or when that can't be told. Either way it prints why, on one line.
unchanged() {
  local tag=$1 dir=$2 tags now changed rc=0 n
  if [ "${ARUGULA_HUB_DEPLOY:-}" = always ]; then
    echo "ARUGULA_HUB_DEPLOY=always: deploying it whatever changed"
    return 1
  fi
  tags=$(running | sort -u) || { echo "fly status failed: can't tell what the hub runs"; return 1; }
  [ -n "$tags" ] || { echo "no machine runs: nothing to compare with"; return 1; }
  [ "$(wc -l <<<"$tags")" = 1 ] || { echo "its machines run different images ($(paste -sd" " <<<"$tags")): deploying them all"; return 1; }
  now=$tags
  [[ $now =~ ^v[0-9] ]] || { echo "it runs $now, not a release's image (a hotfix?): deploying over it"; return 1; }
  if [ "$now" = "$tag" ]; then
    echo "It already runs $tag."
    return 0
  fi
  [ -s "$dir/hub-inputs" ] || { echo "the build left no list of what the hub is built from ($dir/hub-inputs)"; return 1; }
  have_tag "$now" || { echo "can't fetch $now, which it runs, to compare with"; return 1; }
  have_tag "$tag" || { echo "can't fetch $tag to compare"; return 1; }
  changed=$(scripts/ci-hub-changed diff "refs/tags/$now" "refs/tags/$tag" "$dir/hub-inputs" 2>&1) || rc=$?
  case $rc in
    0)
      n=$(wc -l <<<"$changed")
      echo "what it's built from changed since $now ($n): $(head -n 8 <<<"$changed" | paste -sd' ')$([ "$n" -le 8 ] || echo " ...")"
      return 1
      ;;
    1)
      echo "Nothing it's built from changed between $now and $tag ($(grep -cv '^#' "$dir/hub-inputs") inputs, version numbers aside)."
      return 0
      ;;
    *)
      echo "can't compare $now with $tag ($(tail -n 1 <<<"$changed")): deploying it"
      return 1
      ;;
  esac
}

# Two minutes for the machines to settle: fly deploy has already waited for
# the health check, so the first try usually passes.
check() {
  local tag=${1:?usage: ci-control-deploy check TAG}
  for _ in $(seq 1 12); do
    if check_once "$tag"; then
      echo "control at $url runs $tag"
      return 0
    fi
    sleep 10
  done
  echo "::error::control isn't running $tag after its deploy (above: what fly status and $url/control.json said)"
  return 1
}

deploy() {
  local tag=${1:?usage: ci-control-deploy deploy TAG DIR} dir=${2:?usage: ci-control-deploy deploy TAG DIR}
  if [ -z "${FLY_API_TOKEN:-}" ]; then
    echo "::error::FLY_API_TOKEN isn't set: control wasn't deployed. Make a deploy token (fly tokens create deploy -a $app) and set it as the repository secret FLY_API_TOKEN, then re-run this job."
    return 1
  fi
  # A newer release already running (a re-run of an older tag's job) stays.
  # A hotfix's label (deployment-...) isn't a version, so a tag deploys over it.
  local now why
  now=$(running | sort -V | tail -n 1)
  if [[ $now =~ ^v[0-9] ]] && [ "$now" != "$tag" ] &&
    [ "$(printf '%s\n%s\n' "$tag" "$now" | sort -V | tail -n 1)" = "$now" ]; then
    echo "::notice::control already runs $now, newer than $tag: not deployed"
    return 0
  fi
  if why=$(unchanged "$tag" "$dir"); then
    echo "::notice title=Hub not deployed::hub unchanged since $now: not deployed ($why)"
    summary "### The hub: not deployed" "" \
      "hub unchanged since $now: not deployed. $why" "" \
      "To deploy it anyway, set the repository variable \`ARUGULA_HUB_DEPLOY\` to \`always\`, re-run this job, then unset it; or \`just control-deploy\` (docs/control-ops.md, \"Deploys\")."
    check "$now"
    return 0
  fi
  echo "deploying the hub: $why"
  summary "### The hub: deploying $tag" "" "$why"
  local ctx
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  cp "$dir/arugula-control" packaging/control/Dockerfile "$toml" "$ctx"/
  chmod +x "$ctx/arugula-control"
  (cd "$ctx" && flyctl deploy --local-only --ha=false --image-label "$tag")
  check "$tag"
}

case ${1:-} in
  deploy) shift; deploy "$@" ;;
  check) shift; check "$@" ;;
  *) sed -n '5,14p' "$0" >&2; exit 2 ;;
esac

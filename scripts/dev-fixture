#!/usr/bin/env bash
# `just dev-fixture`: seed `just dev`'s daemon (127.0.0.1:7682, state in
# ~/.local/state/arugula-dev) with a workspace to look at and screenshot
# (S39, #1022): 8 sessions; "arugula" has 4 tabs, and its first tab 6 real
# panes (tests running, a shell, an agent, an editor, a diff and a browser on
# a port), arranged around a tall agent pane; two panes want you. It talks to that daemon's socket only, never
# the one in $ARUGULA_SOCK, and closes what's there first.
#
#   just dev                 # in one terminal
#   just dev-fixture         # in another; then open http://localhost:5173
#
# The agent is a real ACP block using a local, deterministic fixture adapter.
# It needs no account, API key or network and identifies itself as a fixture. "Tests" is a loop printing test
# lines, not a real suite. There's no remote pane: that needs a second
# daemon in the host list.
set -euo pipefail

state=${ARUGULA_DEV_STATE:-$HOME/.local/state/arugula-dev}
sock=$state/sock
# A state dir whose path is too long for a socket keeps it elsewhere.
[[ -S $sock || ! -f $state/sock.path ]] || sock=$(cat "$state/sock.path")
repo=$(cd "$(dirname "$0")/.." && pwd)
bin=${ARUGULA_BIN:-${CARGO_TARGET_DIR:-$repo/target}/debug/arugula}
[[ -x $bin ]] || bin=$(command -v arugula) || { echo "no arugula CLI: cargo build -p arugula" >&2; exit 1; }
[[ -S $sock ]] || { echo "no dev daemon at $sock: start it with \`just dev\`" >&2; exit 1; }

# Never the daily daemon: only this socket, and nothing inherited.
unset ARUGULA_SOCK ARUGULA_PANE
a() { "$bin" --socket "$sock" "$@"; }
# A new pane's id, from what `run` and the block commands print (`%N`).
pane() { grep -o '%[0-9]*' | head -1; }

# Start from nothing: close every pane there is (the daemon's own first
# session too), so a rerun gives the same workspace.
mapfile -t old < <(a ls | grep -o '^%[0-9]*' || true)
if ((${#old[@]})); then a close "${old[@]}" >/dev/null; fi

# A web server for the browser pane, in a tab of its own.
port=$("$repo/scripts/free-port")
site=$state/fixture-site
mkdir -p "$site"
# A separate sample repository guarantees a useful diff without editing this checkout.
sample=$(mktemp -d "${TMPDIR:-/tmp}/arugula-fixture.XXXXXX")
printf '%s\n' "$sample" >"$state/fixture-project.path"
cat >"$sample/workspace.ts" <<'EOF'
export interface Workspace {
  name: string;
  panes: number;
  status: "ready" | "working";
}

export const workspace: Workspace = {
  name: "Visual review",
  panes: 4,
  status: "working",
};
EOF
git -C "$sample" init -q
git -C "$sample" add workspace.ts
git -C "$sample" -c user.name='Arugula fixture' -c user.email='fixture@localhost' commit -q --allow-empty -m 'Fixture baseline'
python3 - "$sample/workspace.ts" <<'PYTHON'
from pathlib import Path
import sys
p = Path(sys.argv[1])
p.write_text(p.read_text().replace('panes: 4', 'panes: 6').replace('status: "working",', 'status: "ready",') + '\nexport const description = "Six panes, one shared workspace.";\n')
PYTHON
cat >"$site/index.html" <<EOF
<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Workspace preview · fixture</title>
<style>
* { box-sizing: border-box } body { margin: 0; padding: 24px; background: #101722; color: #dce5f2; font: 14px/1.6 system-ui }
small { color: #7e95b4; letter-spacing: .08em; text-transform: uppercase } h1 { font-size: 27px; line-height: 1.2; margin: 16px 0 10px }
p { color: #9eafc5 } .badge { color: #74d9ba; font-size: 12px } .card { margin-top: 22px; padding: 18px; border: 1px solid #2c3b4e; border-radius: 8px; background: #172130 }
.steps { display: flex; flex-wrap: wrap; gap: 8px } .steps span { padding: 5px 10px; border-radius: 4px; background: #233247; color: #c2d4ea; font-size: 12px }
</style><small>Arugula / local preview</small><h1>One workspace.<br>Everything in view.</h1>
<p>A sample page for comparing pane styling, spacing and embedded content.</p>
<div class="card"><div class="badge">● Preview ready</div><p>Source, changes and running output stay together.</p><div class="steps"><span>01 Inspect</span><span>02 Review</span><span>03 Iterate</span></div></div>
<p><small>Visual fixture · served on :$port</small></p></html>
EOF

# 1. "arugula": its first tab is the six-pane one.
# shellcheck disable=SC2016 # the loop expands in the pane
tests=$(a run --session arugula --cwd "$repo" -- bash -c '
  n=0
  while :; do
    n=$((n + 1))
    echo "running 48 tests (round $n)"
    for i in $(seq 1 48); do
      printf "test layout::arrange_case_%02d ... ok\n" "$i"
      sleep 0.4
    done
    echo "test result: ok. 48 passed; 0 failed; 0 ignored"
    sleep 3
  done' | pane)
shell=$(a run --split "$tests" --cwd "$repo" | pane)
editor=$(a edit "$sample/workspace.ts" --line 1 --split "$shell" | pane)
diff=$(a diff --repo "$sample" --split "$tests" | pane)
printf -v adapter 'python3 %q' "$repo/scripts/dev-fixture-agent.py"
agent=$(a agent --acp "$adapter" --title 'Fixture agent' --cwd "$sample" --split "$editor" 'Review the sample workspace change and summarize what to check.' | pane)
a run --session arugula --cwd "$site" -- python3 -m http.server "$port" --bind 127.0.0.1 >/dev/null
sleep 1
browser=$(a open ":$port" --split "$diff" | pane)

# Compose the six real panes using layout intents over the WebSocket.
python3 - "$sock" "$tests" "$agent" "$editor" "$diff" "$browser" "$shell" <<'PY' || echo "dev-fixture: couldn't arrange the six panes" >&2
import base64, json, os, socket, struct, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(15)
s.connect(sys.argv[1])
key = base64.b64encode(os.urandom(16)).decode()
s.sendall(f"GET /ws HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode())
buf = b""
while b"\r\n\r\n" not in buf:
    buf += s.recv(4096)
buf = buf.split(b"\r\n\r\n", 1)[1]
def need(n):
    global buf
    while len(buf) < n:
        buf += s.recv(65536)
    out, buf = buf[:n], buf[n:]
    return out
def frame():
    b0, b1 = need(2)
    n = b1 & 0x7F
    if n == 126: n = struct.unpack(">H", need(2))[0]
    elif n == 127: n = struct.unpack(">Q", need(8))[0]
    return b0 & 0x0F, need(n)
def send(msg):
    data = json.dumps(msg).encode()
    mask = os.urandom(4)
    head = bytes([0x81]) + (bytes([0x80 | len(data)]) if len(data) < 126 else bytes([0x80 | 126]) + struct.pack(">H", len(data)))
    s.sendall(head + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(data)))
pane = int(sys.argv[2].lstrip("%"))
while True:
    op, data = frame()
    if op == 1 and json.loads(data).get("type") == "hello":
        state = json.loads(data)["state"]
        break
def holds(n):
    return n["pane"] == pane if n["type"] == "pane" else any(holds(c["node"]) for c in n["children"])
tab = next(t["id"] for t in state["tabs"] if holds(t["root"]))
seq = 0
def intent(value):
    global seq, state
    seq += 1
    send({"type": "intent", "id": seq, "intent": value})
    send({"type": "ping", "id": seq})
    while True:
        op, data = frame()
        if op != 1: continue
        m = json.loads(data)
        if m.get("type") == "error": sys.exit(m["message"])
        if m.get("type") == "state": state = m["state"]
        if m.get("type") == "pong": break

def root():
    return next(t["root"] for t in state["tabs"] if t["id"] == tab)

def panes(node):
    return [node["pane"]] if node["type"] == "pane" else [p for c in node["children"] for p in panes(c["node"])]

tests, agent, editor, diff, browser, shell = [int(x.lstrip("%")) for x in sys.argv[2:]]
intent({"op": "arrange", "tab": tab, "preset": "columns"})
# Put the conversation on the left, source/review in the middle and preview/
# running output on the right. Each move uses the actual daemon layout.
for i, desired in enumerate([agent, editor, diff, browser, tests, shell]):
    current = panes(root())[i]
    if current != desired:
        intent({"op": "move_pane", "pane": desired, "target": current, "edge": "center"})
for moving, target in [(diff, editor), (tests, browser), (shell, tests)]:
    intent({"op": "move_pane", "pane": moving, "target": target, "edge": "bottom"})
intent({"op": "resize_split", "split": root()["id"], "weights": [0.38, 0.34, 0.28]})
# Keep preview useful while the two terminal panes occupy compact rows.
right = root()["children"][2]["node"]
intent({"op": "resize_split", "split": right["id"], "weights": [0.5, 0.25, 0.25]})

PY

# 2–4: the other tabs of "arugula".
a run --session arugula --cwd "$repo/web" >/dev/null
log=$(a run --session arugula --cwd "$repo" -- bash -c 'git log --oneline -n 30; exec bash' | pane)

# Attention on two panes: one asks, one is done (once their prompts are
# up, which would clear it).
sleep 2
echo '{"message":"Claude needs your permission to use Bash"}' | a attention needs-input --pane "$shell" >/dev/null
echo '{"message":"git log finished"}' | a attention "done" --pane "$log" >/dev/null

# 5–11: seven more sessions, a pane or two each.
for s in control site docs infra scratch review notes; do
  p=$(a run --session "$s" --cwd "$repo" | pane)
  if [[ $s == control || $s == review ]]; then a run --split "$p" --cwd "$repo" >/dev/null; fi
done

echo "dev-fixture: 8 sessions; the six-pane tab: tests $tests, shell $shell, editor $editor, diff $diff, agent ${agent:-none}, browser $browser on :$port"

#!/usr/bin/env bash
# The merge queue's verdict on a group's commit (queue-verdict.yml), with one
# re-run of whatever failed, so a flake doesn't throw a pull request out.
#
#   scripts/queue-verdict
#
# Each look asks `chant ci verdict` about the commit. 0 passes. 3 is still
# waiting. Anything else is a failure, and then it reads the commit's merge_group
# runs of the workflows ci.green reads, once they've finished (a run can be re-run
# only then):
#   a failed run on its first attempt      re-runs its failed jobs, and waits
#   a failed run past its first attempt    the failure repeats: exits 1
#   no failed run                          looks again, up to
#                                          ARUGULA_VERDICT_ERRORS times (20), then
#                                          exits 1
# chant also exits 1 when GitHub's API answers 5xx, which it did for every group in
# the queue's first busy hour, so a failure with no failed run behind it is taken
# as that: a healthy group mustn't leave the queue over one bad answer.
# It gives up after ARUGULA_VERDICT_MINUTES (85), a little under the job's timeout.
#
# Takes GITHUB_REPOSITORY and GITHUB_SHA from Actions, and gh needs `actions:
# write`. ARUGULA_VERDICT_CHANT and ARUGULA_VERDICT_POLL (30 seconds) are for tests.
set -uo pipefail

repo=${GITHUB_REPOSITORY:?}
sha=${GITHUB_SHA:?}
chant=${ARUGULA_VERDICT_CHANT:-npx --yes @intentius/chant@0.124.69}
poll=${ARUGULA_VERDICT_POLL:-30}
deadline=$(($(date +%s) + ${ARUGULA_VERDICT_MINUTES:-85} * 60))
errors=0
retried=' '

# id, attempt, status and conclusion of the commit's merge_group runs of the suites.
runs() {
  gh api "repos/$repo/actions/runs?head_sha=$sha&event=merge_group&per_page=100" \
    --jq '.workflow_runs[] | select(.name == "check" or .name == "windows" or .name == "windows-desktop") | [.id, .run_attempt, .status, (.conclusion // ""), .name] | @tsv'
}

while [ "$(date +%s)" -lt "$deadline" ]; do
  # shellcheck disable=SC2086 # chant is a command and its arguments
  $chant ci verdict --commit "$sha"
  code=$?
  case "$code" in
    0) exit 0 ;;
    3)
      sleep "$poll"
      continue
      ;;
  esac

  listed=$(runs) || {
    echo "queue-verdict: couldn't read the runs; looking again"
    sleep "$poll"
    continue
  }
  going=0 failed=0 acted=0
  while IFS=$'\t' read -r id attempt status conclusion name; do
    [ -n "$id" ] || continue
    if [ "$status" != completed ]; then
      going=1
      continue
    fi
    case "$conclusion" in
      failure | timed_out | startup_failure) failed=1 ;;
      *) continue ;;
    esac
    if [ "$attempt" -ge 2 ]; then
      echo "queue-verdict: $name failed again on attempt $attempt: the failure repeats"
      if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
        printf 'Failed twice: %s, https://github.com/%s/actions/runs/%s\n' "$name" "$repo" "$id" >>"$GITHUB_STEP_SUMMARY"
      fi
      exit 1
    fi
    case "$retried" in
      *" $id "*) acted=1 ;; # asked already: GitHub hasn't started it yet
      *)
        if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
          printf 'Failed once, re-running: %s, https://github.com/%s/actions/runs/%s\n' "$name" "$repo" "$id" >>"$GITHUB_STEP_SUMMARY"
        fi
        echo "queue-verdict: $name failed; re-running its failed jobs"
        if gh run rerun "$id" -R "$repo" --failed; then
          retried="$retried$id "
          acted=1
        else
          echo "queue-verdict: couldn't re-run it yet; looking again"
          acted=1
        fi
        ;;
    esac
  done <<<"$listed"
  if [ "$going" = 1 ] || [ "$acted" = 1 ]; then
    sleep "$poll"
    continue
  fi
  if [ "$failed" = 0 ]; then
    errors=$((errors + 1))
    if [ "$errors" -ge "${ARUGULA_VERDICT_ERRORS:-20}" ]; then
      echo "queue-verdict: chant keeps saying it failed, and no run has anything to re-run"
      exit 1
    fi
    echo "queue-verdict: chant failed with no failed run behind it (GitHub's API?); looking again"
    sleep "$poll"
  fi
done
echo "queue-verdict: no verdict after ${ARUGULA_VERDICT_MINUTES:-85} minutes"
exit 1

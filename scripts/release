#!/usr/bin/env bash
# Release steps, with the gh CLI. Two lanes (#393): the daemon's `v*`
# tags (.github/workflows/release.yml) and the desktop app's `app-v*` tags
# (.github/workflows/app-release.yml). `releases/latest` is always the
# daemon's: install.sh, install.ps1 and the daemon's update check read it.
#
# The daemon (v*):
#   release check-version TAG      the tag matches the workspace version, on a
#                                  green commit (check-green), and the
#                                  release's client fixtures are copied
#   release upload TAG FILE...     attach files to TAG's release (a draft, made if new)
#   release sums TAG               SHA256SUMS of the release's tarballs and zips
#                                  (each under its new and its old name)
#   release publish TAG            its notes from docs/releases/, then published
#                                  as latest
#   release homebrew TAG           bump the formula in the Homebrew tap
#   release tap-files TAG DIR [SUMS]  what `homebrew` commits, into DIR
#                                  (the formula, formula_renames.json)
#
# The app (app-v*):
#   release check-app-version TAG  the tag matches crates/desktop's version, on
#                                  a green commit (check-green)
#   release sidecars TARGET DIR    the latest daemon release's arugulad and
#                                  arugula for TARGET, checked against its
#                                  SHA256SUMS, into DIR (Windows: with ConPTY)
#   release app-upload TAG FILE... attach files to the app's release (a draft)
#   release app-publish TAG        SHA256SUMS and latest.json, notes from
#                                  docs/releases/app-X.md, published (never as
#                                  latest), and copied to the rolling app-latest
#                                  release the site and the updater read (with
#                                  the old illogical-desktop-* names, #505)
#
# Both lanes:
#   release check-green TAG        TAG's commit passed CI: GitHub has its
#                                  ci/green/<sha> tag and no ci/revoked/<sha>
#                                  (#503), or it only bumps versions on top of
#                                  a commit that did (`bump`).
#                                  ARUGULA_RELEASE_SKIP_GREEN=1 skips it.
#   release bump [patch|minor|major] [--app] [COMMIT] [--dry-run]
#                                  (`just release`) commit a version bump on
#                                  top of the newest green commit on main (or
#                                  COMMIT), tag it vX.Y.Z (--app: app-vX.Y.Z),
#                                  and push the tag with main, the bump merged
#                                  into it (#524). --dry-run makes the bump in a
#                                  throwaway worktree, shows it, and stops.
#
# GH_TOKEN (upload, sums) writes releases (in CI, the job token with
# contents: write; by hand, your gh login); HOMEBREW_TAP_KEY (homebrew) is
# an SSH deploy key for the tap (without it, your own key is used).
set -euo pipefail

repo=${GITHUB_REPOSITORY:-arugula-salad/arugula}
tap=git@github.com:arugula-salad/homebrew-tap.git
# The rolling release with the newest app: its downloads under fixed names,
# and the updater's latest.json (tauri.conf.json's endpoint).
app_latest=app-latest
# Every download an app release has (the updater's .app.tar.gz and .sig
# files come too when TAURI_SIGNING_PRIVATE_KEY is set).
app_downloads="arugula-desktop-linux-{x86_64,aarch64}.{deb,rpm,AppImage} arugula-desktop-macos-{arm64,x86_64}.{zip,dmg} arugula-desktop-windows-x86_64-setup.exe"

# The release for a tag, made if it isn't there yet (both build jobs may
# race to make it; the loser finds the winner's).
ensure_release() {
  local tag=$1 title notes
  gh release view "$tag" -R "$repo" >/dev/null 2>&1 && return
  case "$tag" in
    app-v*) title="Arugula app ${tag#app-v}"
      notes="The desktop app. It installs the daemon on a machine that has none; the daemon updates itself." ;;
    *) title="Arugula ${tag#v}"
      notes="Download the desktop app at https://arugula.io (it installs the daemon). Servers and headless machines: curl -fsSL https://arugula.io/install.sh | sh" ;;
  esac
  # A draft until `publish`: a release with only the first job's files
  # would be "latest" and break every other download link meanwhile.
  gh release create "$tag" -R "$repo" --verify-tag --draft --latest=false --title "$title" --notes "$notes" >/dev/null 2>&1 \
    || gh release view "$tag" -R "$repo" >/dev/null
}

# releases/latest is a daemon release (v*), not an app's.
check_latest() {
  local t
  t=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
  case "$t" in
    v*) echo "releases/latest is still $t" ;;
    *) echo "releases/latest is $t, not a daemon release: fix it with gh release edit vX.Y.Z --latest" >&2; exit 1 ;;
  esac
}

# The Tauri updater's manifest (M46) for app version V, from the .sig files
# in DIR: each platform's download (at BASE) and its signature from the
# updater key. Without signatures (no TAURI_SIGNING_PRIVATE_KEY in the
# build jobs) it lists no platforms, and apps find nothing to update to.
updater() {
  python3 - "$1" "$2" "$3" <<'PY'
import json, os, sys, datetime
v, base, d = sys.argv[1:]
files = {
    "darwin-aarch64": "arugula-desktop-macos-arm64.app.tar.gz",
    "darwin-x86_64": "arugula-desktop-macos-x86_64.app.tar.gz",
    "linux-x86_64": "arugula-desktop-linux-x86_64.AppImage",
    "linux-aarch64": "arugula-desktop-linux-aarch64.AppImage",
    "windows-x86_64": "arugula-desktop-windows-x86_64-setup.exe",
}
platforms = {}
for p, f in files.items():
    sig = os.path.join(d, f + ".sig")
    if os.path.exists(sig):
        platforms[p] = {"signature": open(sig).read().strip(), "url": f"{base}/{f}"}
if not platforms:
    print("no updater signatures: the TAURI_SIGNING_PRIVATE_KEY secret isn't set", file=sys.stderr)
json.dump({"version": v, "pub_date": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
           "platforms": platforms}, sys.stdout, indent=2)
PY
}

# A release starts from a commit CI passed (#503, docs/development.md). The
# tick in chant-ci-green.yml tags each commit on main whose required checks
# passed ci/green/<sha> (chant.workspace.json's ci.green), and one that a
# re-run later failed ci/revoked/<sha>; `chant ci last-green` names the
# newest. Read from GitHub itself, whatever this checkout's remotes are.
url=${GITHUB_SERVER_URL:-https://github.com}/$repo.git

# green SHA prints green, revoked or none, from GitHub's ci/ tags.
green() {
  local refs
  refs=$(git ls-remote "$url" "refs/tags/ci/green/$1" "refs/tags/ci/revoked/$1") ||
    { echo "can't read the ci/ tags at $url" >&2; exit 1; }
  case "$refs" in
    *"refs/tags/ci/revoked/$1"*) echo revoked ;;
    *"refs/tags/ci/green/$1"*) echo green ;;
    *) echo none ;;
  esac
}

check_green() {
  local tag=$1 sha v
  if [ "${ARUGULA_RELEASE_SKIP_GREEN:-}" = 1 ]; then
    echo "ARUGULA_RELEASE_SKIP_GREEN=1: not checking that $tag's commit passed CI" >&2
    return
  fi
  sha=$(git rev-parse --verify -q "$tag^{commit}") || { echo "no commit for $tag here" >&2; exit 1; }
  v=$(green "$sha")
  # `bump` tags a commit that only moves versions on top of a green one, and
  # that commit's own CI may not have finished: its parent's verdict counts.
  # A release workflow's checkout is shallow, so fetch the parent first.
  if [ "$v" = none ]; then
    git rev-parse -q --verify "$sha^" >/dev/null || git fetch -q --depth=2 origin "$sha" 2>/dev/null || true
    if bump_only "$sha"; then
      echo "$tag is on ${sha:0:12}, which only bumps versions: checking its parent"
      sha=$(git rev-parse "$sha^")
      v=$(green "$sha")
    fi
  fi
  case "$v" in
    revoked)
      echo "$tag is on ${sha:0:12}, which passed CI and then failed a re-run (ci/revoked/$sha): release from \`chant ci last-green\`" >&2
      exit 1 ;;
    green) echo "$tag is on ${sha:0:12}, which passed CI (ci/green/$sha)" ;;
    *)
      echo "$tag is on ${sha:0:12}, which has no ci/green tag (yet: CI may still be running): release from \`chant ci last-green\`, or set ARUGULA_RELEASE_SKIP_GREEN=1" >&2
      exit 1 ;;
  esac
}

# The version fields a bump moves (#524), in a manifest (toml), a lock file
# (lock) or a THIRD_PARTY.md (notices), on stdin:
#   vers bump KIND NAMES OLD NEW   OLD becomes NEW for the crates in NAMES
#                                  (" a b ", space-padded)
#   vers blank KIND                every arugula crate's version becomes @V@,
#                                  so two copies that differ only there match
# The workspace's own version, [workspace.package], counts as arugulad's.
# Other crates' versions (a dependency at the same number) stay.
vers() {
  awk -v mode="$1" -v kind="$2" -v names="${3:-}" -v old="${4:-}" -v new="${5:-}" '
    function ours(n) { return mode == "blank" ? n ~ /^arugula/ : index(names, " " n " ") > 0 }
    function nv(v) { return mode == "blank" ? "@V@" : (v == old ? new : v) }
    # The line with the version at P (after its opening quote) replaced.
    function at(line, p,   q) {
      q = index(substr(line, p), "\"")
      return substr(line, 1, p - 1) nv(substr(line, p, q - 1)) substr(line, p + q - 1)
    }
    kind == "lock" {
      # A version line waits for the next one: a crate with a source line
      # comes from a registry or git, and is not ours.
      if (held != "") { print ($0 ~ /^source = /) ? held : at(held, 12); held = "" }
      if ($0 == "[[package]]") pname = ""
      if ($0 ~ /^name = "/) { pname = substr($0, 9, length($0) - 9) }
      if ($0 ~ /^version = "/ && ours(pname)) { held = $0; next }
      print; next
    }
    kind == "toml" {
      if ($0 ~ /^\[/) { sect = $0; pname = (sect == "[workspace.package]") ? "arugulad" : "" }
      if (sect == "[package]" && $0 ~ /^name = "/) pname = substr($0, 9, length($0) - 9)
      if ((sect == "[package]" || sect == "[workspace.package]") && $0 ~ /^version = "/ && ours(pname)) { print at($0, 12); next }
      if ($0 ~ /^arugula[a-z0-9-]* = \{ version = "/) {
        n = $0; sub(/ = .*/, "", n)
        if (ours(n)) { print at($0, index($0, "version = \"") + 11); next }
      }
      print; next
    }
    kind == "notices" && /^- \[arugula[a-z0-9-]* [0-9]/ {
      n = substr($0, 4); sub(/ .*/, "", n)
      if (ours(n)) {
        p = 4 + length(n) + 1; q = index(substr($0, p), "]")
        print substr($0, 1, p - 1) nv(substr($0, p, q - 1)) substr($0, p + q - 1); next
      }
    }
    { print }
    END { if (held != "") print at(held, 12) }'
}

# The files a bump may change, and how vers reads each.
vers_kind() {
  case "$1" in
    Cargo.lock|crates/*/Cargo.lock) echo lock ;;
    Cargo.toml|crates/*/Cargo.toml) echo toml ;;
    THIRD_PARTY.md|crates/*/THIRD_PARTY.md) echo notices ;;
    *) return 1 ;;
  esac
}

# bump_only COMMIT: it changes nothing but arugula's own versions, and
# release notes (docs/releases/), on top of its parent.
bump_only() {
  local c=$1 files f k
  git rev-parse -q --verify "$c^" >/dev/null || return 1
  files=$(git diff --name-only "$c^" "$c")
  [ -n "$files" ] || return 1
  while read -r f; do
    case "$f" in docs/releases/*.md) continue ;; esac
    # The release's copy of the client fixtures (#200), as they were.
    case "$f" in
      crates/proto/fixtures/releases/*/*.jsonl)
        [ "$(git show "$c:$f")" = "$(git show "$c^:crates/proto/fixtures/${f##*/}" 2>/dev/null)" ] && continue
        return 1
        ;;
    esac
    k=$(vers_kind "$f") || return 1
    [ "$(git show "$c^:$f" 2>/dev/null | vers blank "$k")" = "$(git show "$c:$f" 2>/dev/null | vers blank "$k")" ] || return 1
  done <<<"$files"
}

# The daemon's version at REV ([workspace.package]), or the app's
# (crates/desktop's [package]) with --app.
version_at() {
  local f=Cargo.toml s='[workspace.package]'
  if [ "$2" = app ]; then f=crates/desktop/Cargo.toml s='[package]'; fi
  git show "$1:$f" 2>/dev/null | awk -v s="$s" '/^\[/ { in_s = ($0 == s) } in_s && /^version = "/ { print substr($0, 12, length($0) - 12); exit }'
}

next_version() {
  local major minor patch
  IFS=. read -r major minor patch <<<"$1"
  case "$2" in
    major) echo "$((major + 1)).0.0" ;;
    minor) echo "$major.$((minor + 1)).0" ;;
    patch) echo "$major.$minor.$((patch + 1))" ;;
  esac
}

# apply_bump LANE OLD NEW: in the current directory, every file a bump may
# change. The daemon's lane is every arugula crate in Cargo.lock but the
# app; the app's is arugula-desktop.
apply_bump() {
  local lane=$1 old=$2 new=$3 names f k
  if [ "$lane" = app ]; then names=" arugula-desktop "
  else
    names=" $(awk 'BEGIN { RS = "" } /^\[\[package\]\]/ && !/\nsource = / { n = $0; sub(/^[^\n]*\nname = "/, "", n); sub(/".*/, "", n); if (n ~ /^arugula/ && n != "arugula-desktop") printf "%s ", n }' Cargo.lock)"
  fi
  for f in $(git ls-files Cargo.toml Cargo.lock THIRD_PARTY.md 'crates/*/Cargo.toml' 'crates/*/Cargo.lock' 'crates/*/THIRD_PARTY.md'); do
    k=$(vers_kind "$f") || continue
    vers bump "$k" "$names" "$old" "$new" <"$f" >"$f.bump"
    mv "$f.bump" "$f"
  done
  # The daemon's release carries its client fixtures, as `just
  # release-fixtures` copies them (check-version refuses a tag without).
  if [ "$lane" != app ] && ls crates/proto/fixtures/*.jsonl >/dev/null 2>&1; then
    rm -rf "crates/proto/fixtures/releases/$new"
    mkdir -p "crates/proto/fixtures/releases/$new"
    cp crates/proto/fixtures/*.jsonl "crates/proto/fixtures/releases/$new/"
  fi
}

version() { mise exec -- cargo pkgid -p arugulad | sed 's/.*[#@]//'; }

case "${1:-}" in
  check-version)
    v=$(version)
    [ "$2" = "v$v" ] || { echo "tag $2 doesn't match the workspace version $v" >&2; exit 1; }
    # What this release's clients send and see, for later daemons to replay
    # (#200).
    [ -n "$(ls crates/proto/fixtures/releases/"$v"/*.jsonl 2>/dev/null)" ] \
      || { echo "no crates/proto/fixtures/releases/$v: run \`just release-fixtures\` and commit it" >&2; exit 1; }
    check_green "$2"
    ;;
  check-app-version)
    # The app has its own version (#393). Without cargo or mise.
    d=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/desktop/Cargo.toml | head -1)
    [ "$2" = "app-v$d" ] || { echo "tag $2 doesn't match crates/desktop's version $d" >&2; exit 1; }
    check_green "$2"
    ;;
  check-green)
    check_green "$2"
    ;;
  bump)
    # A version bump on top of the newest green commit on main, tagged, so a
    # release needn't wait for its bump to pass CI (#524), like chant's `just
    # release`. The tag's commit only bumps versions, which check-green lets
    # through on its parent's ci/green tag. main gets the bump merged in.
    shift
    part=patch lane=daemon commit='' dry=0
    for a in "$@"; do
      case "$a" in
        major|minor|patch) part=$a ;;
        --app) lane=app ;;
        --dry-run|-n) dry=1 ;;
        -*) echo "release bump: unknown flag $a" >&2; exit 2 ;;
        *) if [ -n "$commit" ]; then echo "release bump: two commits ($commit, $a)" >&2; exit 2; fi; commit=$a ;;
      esac
    done
    git fetch -q "$url" main
    main=$(git rev-parse FETCH_HEAD)
    # The ci/ tags, read once.
    ci=$(git ls-remote "$url" 'refs/tags/ci/*') || { echo "can't read the ci/ tags at $url" >&2; exit 1; }
    is_green() {
      case "$ci" in *"refs/tags/ci/revoked/$1"*) return 1 ;; *"refs/tags/ci/green/$1"*) return 0 ;; *) return 1 ;; esac
    }
    if [ -n "$commit" ]; then
      sha=$(git rev-parse --verify -q "$commit^{commit}") || { echo "$commit isn't a commit here" >&2; exit 1; }
      git merge-base --is-ancestor "$sha" "$main" || { echo "${sha:0:12} isn't on main" >&2; exit 1; }
      is_green "$sha" || { echo "${sha:0:12} has no ci/green tag, or has a ci/revoked one" >&2; exit 1; }
    else
      sha='' skipped=0
      for c in $(git rev-list --first-parent --max-count 200 "$main"); do
        if is_green "$c"; then sha=$c; break; fi
        skipped=$((skipped + 1))
      done
      [ -n "$sha" ] || { echo "no commit among main's last 200 has a ci/green tag without a ci/revoked one" >&2; exit 1; }
      [ "$skipped" = 0 ] || echo "$skipped newer commit(s) on main aren't green yet"
    fi
    # From the higher of the green commit's version and main's: main may
    # already carry a bump that hasn't gone green.
    at_sha=$(version_at "$sha" "$lane") at_main=$(version_at "$main" "$lane")
    cur=$(printf '%s\n' "$at_sha" "$at_main" | sort -V | tail -1)
    new=$(next_version "$cur" "$part")
    if [ "$lane" = app ]; then tag=app-v$new notes=docs/releases/app-$new.md title="Arugula app $new"
    else tag=v$new notes=docs/releases/$new.md title="Arugula $new"; fi
    if [ -n "$(git ls-remote "$url" "refs/tags/$tag")" ]; then echo "$tag already exists" >&2; exit 1; fi
    # Not a commit this lane already released.
    prefix=${tag%"$new"}
    last=$(git ls-remote "$url" "refs/tags/$prefix*" | sed -n "s|^\([0-9a-f]*\)	refs/tags/$prefix\([0-9.]*\)^{}\$|\2 \1|p" | sort -V | tail -1)
    if [ -n "$last" ]; then
      git fetch -q "$url" "${last#* }" 2>/dev/null || git fetch -q "$url" "refs/tags/$prefix${last% *}"
      if git merge-base --is-ancestor "$sha" "${last#* }"; then
        echo "${sha:0:12} is already released in $prefix${last% *}" >&2; exit 1
      fi
    fi
    # The notes come from main, where they can land without waiting for CI.
    # A dry run goes on without them, to show the rest.
    have_notes=1
    if ! git cat-file -e "$main:$notes" 2>/dev/null; then
      if [ "$dry" = 1 ]; then have_notes=0; echo "main has no $notes: merge the release notes before the release"
      else echo "main has no $notes: merge the release notes first" >&2; exit 1; fi
    fi
    echo "$tag: $at_sha -> $new on ${sha:0:12} ($(git log -1 --format=%s "$sha")), the newest green commit; main is at ${main:0:12}"
    wt=$(mktemp -d "${TMPDIR:-/tmp}/arugula-release.XXXXXX")
    top=$(git rev-parse --show-toplevel)
    git worktree add -q --detach "$wt" "$sha"
    trap 'cd "$top" && git worktree remove --force "$wt" >/dev/null 2>&1 || true' EXIT
    cd "$wt"
    apply_bump "$lane" "$at_sha" "$new"
    if [ "$have_notes" = 1 ]; then mkdir -p "$(dirname "$notes")" && git show "$main:$notes" >"$notes"; fi
    git add -A
    if [ "$lane" = app ]; then vfile=crates/desktop/Cargo.toml; else vfile=Cargo.toml; fi
    if git diff --cached --quiet -- "$vfile"; then echo "the bump didn't change $vfile" >&2; exit 1; fi
    git diff --cached --stat
    if [ "$dry" = 1 ]; then
      echo "Dry run: nothing committed, tagged or pushed."
      exit 0
    fi
    git commit -qm "$title"
    bumped=$(git rev-parse HEAD)
    bump_only "$bumped" || { echo "the bump commit changes more than versions: $(git diff --name-only "$sha" "$bumped" | tr '\n' ' ')" >&2; exit 1; }
    git tag -a "$tag" -m "${title/Arugula/arugula}"
    # main gets the bump: a fast-forward when it's still at the green commit,
    # else a merge. A conflict in the version lines (main bumped too) takes
    # main's files and bumps them again; any other conflict stops here.
    if [ "$sha" = "$main" ]; then
      git checkout -q --detach "$bumped"
    else
      git checkout -q --detach "$main"
      if ! git merge -q --no-ff --no-commit "$bumped" >/dev/null 2>&1; then
        for f in $(git diff --name-only --diff-filter=U); do
          case "$f" in "$notes") ;; *)
            vers_kind "$f" >/dev/null || { git merge --abort; git tag -d "$tag" >/dev/null; echo "merging $tag into main conflicts in $f" >&2; exit 1; } ;;
          esac
        done
        for f in $(git diff --name-only --cached "$main"); do
          # New in the bump (the release's fixtures): kept as they are.
          git cat-file -e "$main:$f" 2>/dev/null || continue
          case "$f" in "$notes") ;; *) git show "$main:$f" >"$f" ;; esac
        done
        apply_bump "$lane" "$at_main" "$new"
        git add -A
      fi
      git commit -qm "Merge $tag into main"
    fi
    if ! git push -q --atomic "$url" HEAD:refs/heads/main "refs/tags/$tag"; then
      git tag -d "$tag" >/dev/null
      echo "pushing main and $tag was refused (main moved?): nothing was pushed; run it again" >&2
      exit 1
    fi
    echo "pushed $tag (${bumped:0:12}) and main ($(git rev-parse --short=12 HEAD))"
    ;;
  sidecars)
    # From the latest daemon release (releases/latest), which this app then
    # carries for a machine with no daemon.
    target=$2; out=$3
    tag=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
    case "$tag" in v*) ;; *) echo "releases/latest is $tag, not a daemon release" >&2; exit 1 ;; esac
    v=${tag#v}
    case "$target" in *-windows-*) ext=zip ;; *) ext=tar.gz ;; esac
    name=arugula-$v-$target
    dir=$(mktemp -d)
    gh release download "$tag" -R "$repo" -p "$name.$ext" -p SHA256SUMS -D "$dir"
    want=$(awk -v f="$name.$ext" '$2 == f { print $1 }' "$dir/SHA256SUMS")
    [ -n "$want" ] || { echo "$name.$ext isn't in $tag's SHA256SUMS" >&2; exit 1; }
    if command -v sha256sum >/dev/null; then got=$(sha256sum "$dir/$name.$ext" | cut -d' ' -f1); else got=$(shasum -a 256 "$dir/$name.$ext" | cut -d' ' -f1); fi
    [ "$got" = "$want" ] || { echo "$name.$ext doesn't match $tag's SHA256SUMS" >&2; exit 1; }
    if [ "$ext" = zip ]; then
      powershell -NoProfile -Command "Expand-Archive -Force '$(cygpath -w "$dir/$name.zip")' '$(cygpath -w "$dir")'"
    else
      tar -xzf "$dir/$name.tar.gz" -C "$dir"
    fi
    mkdir -p "$out"
    for f in arugulad arugula arugulad.exe arugula.exe conpty.dll OpenConsole.exe ConPTY-LICENSE.txt; do
      [ ! -f "$dir/$name/$f" ] || cp "$dir/$name/$f" "$out/"
    done
    echo "$out: arugulad $v for $target, from $tag"
    "$out/arugulad" --version 2>/dev/null || true
    ;;
  upload)
    tag=$2; shift 2
    ensure_release "$tag"
    # --clobber replaces an asset of the same name (a re-run).
    gh release upload "$tag" -R "$repo" --clobber "$@"
    ;;
  publish)
    # Last: the notes from docs/releases/X.md, then out of draft as latest.
    tag=$2; notes=docs/releases/${tag#v}.md
    if [ -f "$notes" ]; then gh release edit "$tag" -R "$repo" --notes-file "$notes"; fi
    gh release edit "$tag" -R "$repo" --draft=false --latest
    check_latest
    ;;
  app-upload)
    tag=$2; shift 2
    ensure_release "$tag"
    gh release upload "$tag" -R "$repo" --clobber "$@"
    ;;
  app-publish)
    tag=$2; v=${tag#app-v}
    dir=$(mktemp -d)
    gh release download "$tag" -R "$repo" -p 'arugula-desktop-*' -D "$dir"
    for f in $(eval "echo $app_downloads"); do
      [ -f "$dir/$f" ] || { echo "the release has no $f" >&2; exit 1; }
    done
    (cd "$dir" && sha256sum -- arugula-desktop-* > SHA256SUMS && cat SHA256SUMS)
    gh release upload "$tag" -R "$repo" --clobber "$dir/SHA256SUMS"
    # The updater's manifest, pointing at this release's own files (which
    # never change, so a copy of it anywhere stays right).
    updater "$v" "https://github.com/$repo/releases/download/$tag" "$dir" >"$dir/latest.json"
    gh release upload "$tag" -R "$repo" --clobber "$dir/latest.json"
    notes=docs/releases/app-$v.md
    if [ -f "$notes" ]; then gh release edit "$tag" -R "$repo" --notes-file "$notes"; fi
    gh release edit "$tag" -R "$repo" --draft=false --latest=false
    # The rolling release: made once (its tag follows the newest app's
    # commit), then its files replaced. Never latest.
    sha=$(gh api "repos/$repo/git/ref/tags/$tag" --jq .object.sha)
    gh api "repos/$repo/git/tags/$sha" --jq .object.sha >/dev/null 2>&1 && sha=$(gh api "repos/$repo/git/tags/$sha" --jq .object.sha)
    # With TAG_TOKEN when it's set: the workflow's GITHUB_TOKEN can't move
    # this tag (#526). A person's own gh login can.
    tag_api() { if [ -n "${TAG_TOKEN:-}" ]; then GH_TOKEN=$TAG_TOKEN gh api "$@"; else gh api "$@"; fi; }
    if gh api "repos/$repo/git/ref/tags/$app_latest" >/dev/null 2>&1; then
      tag_api -X PATCH "repos/$repo/git/refs/tags/$app_latest" -f sha="$sha" -F force=true >/dev/null
    else
      tag_api -X POST "repos/$repo/git/refs" -f ref="refs/tags/$app_latest" -f sha="$sha" >/dev/null
    fi
    gh release view "$app_latest" -R "$repo" >/dev/null 2>&1 \
      || gh release create "$app_latest" -R "$repo" --verify-tag --latest=false --title "Arugula app (latest)" \
        --notes "The newest desktop app, always: its downloads keep these names. Each version's own release is app-vX.Y.Z." >/dev/null
    # Its downloads under their old names too, illogical-desktop-*: the site
    # before the rename, older docs and links point at those here (#505,
    # drop in #508). Its SHA256SUMS lists both. latest.json (what apps from
    # before the rename read here too) points at the new names in $tag.
    r=$dir/rolling; mkdir "$r"
    cp "$dir"/arugula-desktop-* "$dir/latest.json" "$r/"
    for f in $(eval "echo $app_downloads"); do cp "$dir/$f" "$r/illogical-desktop-${f#arugula-desktop-}"; done
    (cd "$r" && sha256sum -- arugula-desktop-* illogical-desktop-* > SHA256SUMS)
    gh release upload "$app_latest" -R "$repo" --clobber "$r"/*
    gh release edit "$app_latest" -R "$repo" --latest=false --notes "The newest desktop app, always: $v ($tag). Its downloads keep these names." >/dev/null
    check_latest
    ;;
  sums)
    ensure_release "$2"
    dir=$(mktemp -d)
    gh release download "$2" -R "$repo" -p '*.tar.gz' -p 'arugula-[0-9]*.zip' -p 'illogical-[0-9]*.zip' -D "$dir"
    # Each under its old name too, for older daemons' self-update
    # (scripts/dist-pack, #505, drop in #508).
    for p in arugula illogical; do
      n=$(find "$dir" -name "$p-[0-9]*.tar.gz" | wc -l | tr -d " ")
      [ "$n" = 4 ] || { echo "expected 4 $p tarballs, found $n" >&2; exit 1; }
      # Windows' zip (install.ps1's, M59).
      w=$(find "$dir" -name "$p-[0-9]*-x86_64-pc-windows-msvc.zip" | wc -l | tr -d " ")
      [ "$w" = 1 ] || { echo "expected the $p Windows zip, found $w" >&2; exit 1; }
    done
    (cd "$dir" && sha256sum -- arugula-[0-9]*.tar.gz arugula-[0-9]*.zip illogical-[0-9]*.tar.gz illogical-[0-9]*.zip > SHA256SUMS && cat SHA256SUMS)
    gh release upload "$2" -R "$repo" --clobber "$dir/SHA256SUMS"
    ;;
  tap-files)
    # What `homebrew` commits, into a checkout of the tap at DIR; SUMS is
    # the release's SHA256SUMS (a file; by default, the release's own).
    tag=$2; v=${tag#v}; dir=$3
    if [ -n "${4:-}" ]; then sums=$(cat "$4"); else sums=$(curl -fsSL "https://github.com/$repo/releases/download/$tag/SHA256SUMS"); fi
    sha() {
      local s
      s=$(echo "$sums" | awk -v f="arugula-$v-$1.tar.gz" '$2 == f { print $1 }')
      [ -n "$s" ] || { echo "arugula-$v-$1.tar.gz isn't in $tag's SHA256SUMS" >&2; exit 1; }
      echo "$s"
    }
    # Each on its own line, so a missing one stops here (set -e).
    sed=(-e "s/@VERSION@/$v/g")
    s=$(sha aarch64-apple-darwin); sed+=(-e "s/@SHA_MAC@/$s/")
    s=$(sha x86_64-apple-darwin); sed+=(-e "s/@SHA_MAC_INTEL@/$s/")
    s=$(sha x86_64-unknown-linux-musl); sed+=(-e "s/@SHA_LINUX_X86@/$s/")
    s=$(sha aarch64-unknown-linux-musl); sed+=(-e "s/@SHA_LINUX_ARM@/$s/")
    mkdir -p "$dir/Formula"
    sed "${sed[@]}" packaging/homebrew/arugula.rb.in > "$dir/Formula/arugula.rb"
    # The formula was `illogical`: Homebrew moves its installs to `arugula`
    # on `brew upgrade` when formula_renames.json says so and the old
    # formula is gone (#505). Kept: the rename outlives #508.
    rm -f "$dir/Formula/illogical.rb"
    python3 -I - "$dir/formula_renames.json" <<'PY'
import json, os, sys
p = sys.argv[1]
renames = json.load(open(p)) if os.path.exists(p) else {}
renames["illogical"] = "arugula"
with open(p, "w") as f:
    json.dump(renames, f, indent=2, sort_keys=True)
    f.write("\n")
PY
    ;;
  homebrew)
    tag=$2; v=${tag#v}
    # The deploy key in CI; by hand, your own SSH key.
    if [ -n "${HOMEBREW_TAP_KEY:-}" ]; then
      key=$(mktemp); trap 'rm -f "$key"' EXIT
      printf '%s\n' "$HOMEBREW_TAP_KEY" > "$key"; chmod 600 "$key"
      export GIT_SSH_COMMAND="ssh -i $key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
    fi
    dir=$(mktemp -d)
    git clone -q "$tap" "$dir"
    "$0" tap-files "$tag" "$dir"
    cd "$dir"
    git add -A Formula formula_renames.json
    if git diff --cached --quiet; then echo "formula already at $v"; exit 0; fi
    git -c user.name="arugula release" -c user.email="noreply@inevitable.fyi" commit -qm "arugula $v"
    git push -q origin HEAD
    echo "formula bumped to $v"
    ;;
  *)
    sed -n '2,44p' "$0" >&2
    exit 2
    ;;
esac

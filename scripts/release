#!/usr/bin/env bash
# Release steps, with the gh CLI. Two lanes (#393): the daemon's `v*`
# tags (.github/workflows/release.yml) and the desktop app's `app-v*` tags
# (.github/workflows/app-release.yml). `releases/latest` is always the
# daemon's: install.sh, install.ps1 and the daemon's update check read it.
#
# Each reads its own green tag (#307): the daemon's ci/green/<sha> (every
# phase; chant's ci/green-daemon/<sha> is the same verdict), the app's
# ci/green-app/<sha>, and the server's ci/green-server/<sha>
# (chant.workspace.json's ci.green.lanes, docs/development.md).
#
# A release is a green commit as it is (#1986): its tag names the commit CI
# passed, and no commit moves the versions. The build jobs write the tag's
# version into their own checkout (`stamp`) before they build, as chant's
# release-pack.sh does, so the binaries carry it; the files in git keep the
# version they had.
#
# The daemon (v*):
#   release check-version TAG      TAG's commit can be the daemon's release of
#                                  TAG's version: it passed the rare jobs
#                                  (check-rare)
#   release check-fixtures TAG     main has TAG's client fixtures
#                                  (crates/proto/fixtures/releases/X.Y.Z), which
#                                  `bump` commits there after the tag; a warning
#                                  (in CI, in the job's summary) when it hasn't,
#                                  never a failure
#   release check-rare TAG         TAG's commit passed rare-nightly.yml's jobs,
#                                  which ci/green doesn't count (#305): GitHub
#                                  has its ci/rare/<sha> tag
#   release formula TAG DIR        the Homebrew formula's template for TAG's
#                                  version, into DIR/arugula.rb, for chant's
#                                  homebrew target (release/daemon)
#
# The app (app-v*):
#   release sidecars TARGET DIR    the latest daemon release's arugulad and
#                                  arugula for TARGET, checked against its
#                                  SHA256SUMS, into DIR (Windows: with ConPTY)
#
# Publishing, which chant does (#1986): release.yml and app-release.yml cut
# the tag's release with `chant release cut --lane` from the commit the tag
# names, and publish it with `chant release publish` (release/daemon and
# release/app, the members that declare what each publishes). These are the
# steps around it:
#   release stamp TAG              TAG's version into this checkout: the
#                                  daemon's (every arugula crate but the app,
#                                  and the server's workspace) for v*, the
#                                  app's (crates/desktop) for app-v*
#   release sums TAG DIR           SHA256SUMS in DIR of TAG's files there: a
#                                  daemon release's four tarballs and Windows
#                                  zip, or an app release's every download
#   release draft TAG              TAG's GitHub release as a draft, titled, with
#                                  its notes from docs/releases/ as TAG has
#                                  them (a daemon release's without the headline
#                                  section); the publish fills and publishes it
#   release check-latest           releases/latest is still a daemon release
#
# Both lanes:
#   release check-green TAG [LANE] TAG's commit passed CI: GitHub has its
#                                  green tag and no revoked one (#503). LANE is
#                                  daemon (ci/green/<sha>, ci/revoked/<sha>),
#                                  app (ci/green-app/<sha>) or server
#                                  (ci/green-server/<sha>); without it, app for
#                                  an app-v* tag, else daemon.
#                                  ARUGULA_RELEASE_SKIP_GREEN=1 skips it. The
#                                  release workflows leave this to chant's cut.
#   release last-green [LANE]      the newest commit on main with LANE's green
#                                  tag and no revoked one (default daemon), as
#                                  `bump` picks it; `last-green server` is the
#                                  server's newest deployable commit
#   release bump [patch|minor|major] [--app] [COMMIT|--older] [--rare] [--dry-run]
#                                  (`just release`) tag the newest green commit
#                                  on main (or COMMIT; --app: the newest with
#                                  ci/green-app) vX.Y.Z (--app: app-vX.Y.Z),
#                                  the next version after the lane's newest
#                                  tag, and push the tag. The commit must
#                                  already have the release's notes
#                                  (docs/releases/). For the daemon, it then
#                                  commits the tag's client fixtures to main
#                                  (crates/proto/fixtures/releases/X.Y.Z, #200)
#                                  and pushes that; if main refuses it, the
#                                  release still stands and it prints the
#                                  `just release-fixtures X.Y.Z` to run.
#                                  When main has newer commits that
#                                  aren't green, it lists them and stops;
#                                  --older releases without them (#1679).
#                                  A daemon release stops too when the commit
#                                  has no ci/rare tag (check-rare); --rare
#                                  starts the rare jobs on it, waits for them
#                                  and goes on if they pass.
#                                  --dry-run shows the tag and stops.
#                                  ARUGULA_RELEASE_TRAILER, when set (one line,
#                                  `Key: value`), ends the tag's message: the
#                                  arugula-release deploy driver's
#                                  `Arugula-Deploy: dep_...` (M221), which runs
#                                  this from a deploy's box.
#   release blank PATH             the file PATH names (a Cargo.toml, Cargo.lock
#                                  or THIRD_PARTY.md), read from stdin, with every
#                                  arugula crate's version as @V@, so two copies
#                                  that differ only by a version match
#                                  (scripts/ci-hub-changed)
#
# GH_TOKEN (bump --rare) starts and watches a run of rare-nightly.yml;
# GH_TOKEN (draft, check-latest, sidecars) reads and writes releases (in CI,
# the job token with contents: write; by hand, your gh login).
set -euo pipefail

repo=${GITHUB_REPOSITORY:-arugula-salad/arugula}
# Every download an app release has (the updater's .app.tar.gz and .sig
# files come too: release/app/chant.config.ts names them all).
app_downloads="arugula-desktop-linux-{x86_64,aarch64}.{deb,rpm,AppImage} arugula-desktop-macos-{arm64,x86_64}.{zip,dmg} arugula-desktop-windows-x86_64-setup.exe"

# A daemon release's headline section in its notes (docs/releases/X.Y.Z.md):
# a fenced block the web client's What's new is built from
# (scripts/whats-new.mjs). It's left out of the GitHub release's body.
headlines='```whats-new'
without_headlines() { sed '/^```whats-new$/,/^```$/d'; }

# The release for a tag, made as a draft if it isn't there yet.
ensure_release() {
  local tag=$1 title notes
  gh release view "$tag" -R "$repo" >/dev/null 2>&1 && return
  case "$tag" in
    app-v*) title="Arugula app ${tag#app-v}"
      notes="The desktop app. It installs the daemon on a machine that has none; the daemon updates itself." ;;
    *) title="Arugula ${tag#v}"
      notes="Download the desktop app at https://arugula.io (it installs the daemon). Servers and headless machines: curl -fsSL https://arugula.io/install.sh | sh" ;;
  esac
  # A draft until chant's publish fills it and publishes it, so no one sees
  # a release without its files.
  gh release create "$tag" -R "$repo" --verify-tag --draft --latest=false --title "$title" --notes "$notes" >/dev/null 2>&1 \
    || gh release view "$tag" -R "$repo" >/dev/null
}

# releases/latest is a daemon release (v*), not an app's.
check_latest() {
  local t
  t=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
  case "$t" in
    v*) echo "releases/latest is still $t" ;;
    *) echo "releases/latest is $t, not a daemon release: fix it with gh release edit vX.Y.Z --latest" >&2; exit 1 ;;
  esac
}

# A release starts from a commit CI passed (#503, docs/development.md). The
# tick in chant-ci-green.yml tags each commit on main whose required checks
# passed ci/green/<sha> (chant.workspace.json's ci.green), and one that a
# re-run later failed ci/revoked/<sha>; `chant ci last-green` names the
# newest. Each lane in ci.green.lanes (#307) gets its own pair from the same
# runs, ci/green-<lane>/<sha> and ci/revoked-<lane>/<sha>, for the phases
# that lane needs. Read from GitHub itself, whatever this checkout's remotes
# are.
url=${GITHUB_SERVER_URL:-https://github.com}/$repo.git

# lane_tags LANE sets green_tag and revoked_tag to LANE's tag prefixes. The
# daemon's lane reads the plain ci/green, which needs every phase (chant's
# ci/green-daemon is the same verdict), until the arugula-release driver and
# everything else reading ci/green move.
lane_tags() {
  case "$1" in
    daemon) green_tag=ci/green revoked_tag=ci/revoked ;;
    app|server) green_tag=ci/green-$1 revoked_tag=ci/revoked-$1 ;;
    *) echo "no release lane $1: daemon, app or server" >&2; exit 2 ;;
  esac
}

# The lane a tag is for: app-v* is the app's, anything else the daemon's.
tag_lane() { case "$1" in app-v*) echo app ;; *) echo daemon ;; esac; }

# green SHA LANE prints green, revoked or none, from GitHub's ci/ tags.
green() {
  local refs green_tag revoked_tag
  lane_tags "$2"
  refs=$(git ls-remote "$url" "refs/tags/$green_tag/$1" "refs/tags/$revoked_tag/$1") ||
    { echo "can't read the ci/ tags at $url" >&2; exit 1; }
  case "$refs" in
    *"refs/tags/$revoked_tag/$1"*) echo revoked ;;
    *"refs/tags/$green_tag/$1"*) echo green ;;
    *) echo none ;;
  esac
}

# newest_green LANE MAIN CI: the newest of MAIN's last 200 first-parent
# commits with LANE's green tag and no revoked one, in CI (`git ls-remote`'s
# ci/ tags); nothing when there's none.
newest_green() {
  local green_tag revoked_tag c
  lane_tags "$1"
  for c in $(git rev-list --first-parent --max-count 200 "$2"); do
    case "$3" in
      *"refs/tags/$revoked_tag/$c"*) ;;
      *"refs/tags/$green_tag/$c"*) echo "$c"; return ;;
    esac
  done
}

check_green() {
  local tag=$1 lane=${2:-} sha v green_tag revoked_tag
  [ -n "$lane" ] || lane=$(tag_lane "$tag")
  lane_tags "$lane"
  if [ "${ARUGULA_RELEASE_SKIP_GREEN:-}" = 1 ]; then
    echo "ARUGULA_RELEASE_SKIP_GREEN=1: not checking that $tag's commit passed CI" >&2
    return
  fi
  sha=$(git rev-parse --verify -q "$tag^{commit}") || { echo "no commit for $tag here" >&2; exit 1; }
  v=$(green "$sha" "$lane")
  case "$v" in
    revoked)
      echo "$tag is on ${sha:0:12}, which passed the $lane lane's CI and then failed a re-run ($revoked_tag/$sha): release from \`scripts/release last-green $lane\`" >&2
      exit 1 ;;
    green) echo "$tag is on ${sha:0:12}, which passed the $lane lane's CI ($green_tag/$sha)" ;;
    *)
      echo "$tag is on ${sha:0:12}, which has no $green_tag tag (yet: CI may still be running): release from \`scripts/release last-green $lane\`, or set ARUGULA_RELEASE_SKIP_GREEN=1" >&2
      exit 1 ;;
  esac
}

# The jobs that rarely fail (#305: test-postgres, core, testnet, stack and
# the WebKit specs) left check.yml for rare-nightly.yml, which ci/green
# doesn't count, so a daemon release needs them to have passed on its
# commit too. A run of rare-nightly.yml whose jobs all passed tags the
# commit it tested ci/rare/<sha> (with CI_GREEN_TOKEN: the ci/ tags are
# protected), read here as ci/green is: from GitHub, with git alone, so
# release.yml and the arugula-release deploy driver need no API token.
rare_workflow=rare-nightly.yml

# rare SHA: GitHub has SHA's ci/rare tag.
rare() {
  local refs
  refs=$(git ls-remote "$url" "refs/tags/ci/rare/$1") || { echo "can't read the ci/ tags at $url" >&2; exit 1; }
  [ -n "$refs" ]
}

# run_rare SHA: start the rare jobs on SHA, unless a run of them on it is
# going already, wait for it, and fail unless SHA has its ci/rare tag after.
# With gh (GH_TOKEN, or your gh login: actions: write). A run's name says
# which commit it tests ("rare-nightly SHA"): a dispatched run's head is
# main's, and it checks out its `sha` input.
run_rare() {
  local sha=$1 id='' link=''
  running() {
    gh run list -R "$repo" -w "$rare_workflow" -b main -L 50 --json displayTitle,status,databaseId,url \
      --jq ".[] | select(.displayTitle == \"rare-nightly $sha\" and .status != \"completed\") | \"\(.databaseId) \(.url)\"" | head -1
  }
  read -r id link <<<"$(running)" || true
  if [ -z "$id" ]; then
    echo "starting the rare jobs on ${sha:0:12} ($rare_workflow)"
    gh workflow run "$rare_workflow" -R "$repo" --ref main -f sha="$sha" >/dev/null || return 1
    # The new run is listed a few seconds after it's asked for.
    for _ in $(seq 1 24); do
      read -r id link <<<"$(running)" || true
      [ -z "$id" ] || break
      sleep "${ARUGULA_RELEASE_POLL:-5}"
    done
    [ -n "$id" ] || { echo "the rare jobs' run on ${sha:0:12} didn't show up after 2 min" >&2; return 1; }
  fi
  echo "waiting for the rare jobs on ${sha:0:12}: $link"
  gh run watch "$id" -R "$repo" --exit-status --interval 30 >/dev/null || true
  if rare "$sha"; then echo "${sha:0:12} passed the rare jobs (ci/rare/$sha)"
  else echo "the rare jobs didn't pass on ${sha:0:12}: $link" >&2; return 1; fi
}

# check_rare TAG: TAG's commit has a ci/rare tag. ARUGULA_RELEASE_SKIP_GREEN=1 skips this too:
# it's for a release CI can't vouch for at all.
check_rare() {
  local tag=$1 sha
  if [ "${ARUGULA_RELEASE_SKIP_GREEN:-}" = 1 ]; then
    echo "ARUGULA_RELEASE_SKIP_GREEN=1: not checking that $tag's commit passed the rare jobs" >&2
    return
  fi
  sha=$(git rev-parse --verify -q "$tag^{commit}") || { echo "no commit for $tag here" >&2; exit 1; }
  if rare "$sha"; then echo "$tag is on ${sha:0:12}, which passed the rare jobs (ci/rare/$sha)"; return; fi
  echo "$tag is on ${sha:0:12}, which has no ci/rare tag: the rare jobs ($rare_workflow) haven't passed on it. \`just release --rare\` starts them on the newest green commit and waits" >&2
  exit 1
}

# The version fields a release's version moves (#524), in a manifest (toml), a lock file
# (lock) or a THIRD_PARTY.md (notices), on stdin:
#   vers bump KIND NAMES OLD NEW   OLD becomes NEW for the crates in NAMES
#                                  (" a b ", space-padded)
#   vers blank KIND                every arugula crate's version becomes @V@,
#                                  so two copies that differ only there match
# The workspace's own version, [workspace.package], counts as arugulad's.
# Other crates' versions (a dependency at the same number) stay.
vers() {
  awk -v mode="$1" -v kind="$2" -v names="${3:-}" -v old="${4:-}" -v new="${5:-}" '
    function ours(n) { return mode == "blank" ? n ~ /^arugula/ : index(names, " " n " ") > 0 }
    function nv(v) { return mode == "blank" ? "@V@" : (v == old ? new : v) }
    # The line with the version at P (after its opening quote) replaced.
    function at(line, p,   q) {
      q = index(substr(line, p), "\"")
      return substr(line, 1, p - 1) nv(substr(line, p, q - 1)) substr(line, p + q - 1)
    }
    kind == "lock" {
      # A version line waits for the next one: a crate with a source line
      # comes from a registry or git, and is not ours.
      if (held != "") { print ($0 ~ /^source = /) ? held : at(held, 12); held = "" }
      if ($0 == "[[package]]") pname = ""
      if ($0 ~ /^name = "/) { pname = substr($0, 9, length($0) - 9) }
      if ($0 ~ /^version = "/ && ours(pname)) { held = $0; next }
      print; next
    }
    kind == "toml" {
      if ($0 ~ /^\[/) { sect = $0; pname = (sect == "[workspace.package]") ? "arugulad" : "" }
      if (sect == "[package]" && $0 ~ /^name = "/) pname = substr($0, 9, length($0) - 9)
      if ((sect == "[package]" || sect == "[workspace.package]") && $0 ~ /^version = "/ && ours(pname)) { print at($0, 12); next }
      if ($0 ~ /^arugula[a-z0-9-]* = \{ version = "/) {
        n = $0; sub(/ = .*/, "", n)
        if (ours(n)) { print at($0, index($0, "version = \"") + 11); next }
      }
      print; next
    }
    kind == "notices" && /^- \[arugula[a-z0-9-]* [0-9]/ {
      n = substr($0, 4); sub(/ .*/, "", n)
      if (ours(n)) {
        p = 4 + length(n) + 1; q = index(substr($0, p), "]")
        print substr($0, 1, p - 1) nv(substr($0, p, q - 1)) substr($0, p + q - 1); next
      }
    }
    { print }
    END { if (held != "") print at(held, 12) }'
}

# The files a version may change, and how vers reads each.
vers_kind() {
  case "$1" in
    Cargo.lock|server/Cargo.lock|crates/*/Cargo.lock) echo lock ;;
    Cargo.toml|server/Cargo.toml|crates/*/Cargo.toml) echo toml ;;
    THIRD_PARTY.md|server/THIRD_PARTY.md|crates/*/THIRD_PARTY.md) echo notices ;;
    *) return 1 ;;
  esac
}

# The daemon's version at REV ([workspace.package]), or the app's
# (crates/desktop's [package]) with --app.
version_at() {
  local f=Cargo.toml s='[workspace.package]'
  if [ "$2" = app ]; then f=crates/desktop/Cargo.toml s='[package]'; fi
  git show "$1:$f" 2>/dev/null | awk -v s="$s" '/^\[/ { in_s = ($0 == s) } in_s && /^version = "/ { print substr($0, 12, length($0) - 12); exit }'
}

next_version() {
  local major minor patch
  IFS=. read -r major minor patch <<<"$1"
  case "$2" in
    major) echo "$((major + 1)).0.0" ;;
    minor) echo "$major.$((minor + 1)).0" ;;
    patch) echo "$major.$minor.$((patch + 1))" ;;
  esac
}

# apply_version LANE OLD NEW: in the current directory, every file a
# version is in, from OLD to NEW. The daemon's lane is every arugula crate in
# Cargo.lock and server/Cargo.lock (the server's workspace, whose
# [workspace.package] version is the root's) but the app; the app's is
# arugula-desktop.
apply_version() {
  local lane=$1 old=$2 new=$3 names f k
  if [ "$lane" = app ]; then names=" arugula-desktop "
  else
    # Not mapfile: macOS's bash 3.2 has none.
    local locks=() l
    while IFS= read -r l; do locks+=("$l"); done < <(git ls-files Cargo.lock server/Cargo.lock)
    names=" $(awk 'BEGIN { RS = "" } /^\[\[package\]\]/ && !/\nsource = / { n = $0; sub(/^[^\n]*\nname = "/, "", n); sub(/".*/, "", n); if (n ~ /^arugula/ && n != "arugula-desktop") printf "%s ", n }' "${locks[@]}" | tr ' ' '\n' | sort -u | tr '\n' ' ')"
  fi
  for f in $(git ls-files Cargo.toml Cargo.lock THIRD_PARTY.md server/Cargo.toml server/Cargo.lock server/THIRD_PARTY.md 'crates/*/Cargo.toml' 'crates/*/Cargo.lock' 'crates/*/THIRD_PARTY.md'); do
    k=$(vers_kind "$f") || continue
    vers bump "$k" "$names" "$old" "$new" <"$f" >"$f.new"
    mv "$f.new" "$f"
  done
}

# The version a tag names (v1.2.3, app-v1.2.3: 1.2.3), or a refusal.
tag_version() {
  local v
  case "$1" in app-v*) v=${1#app-v} ;; v*) v=${1#v} ;; *) v='' ;; esac
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "$1 isn't a release tag (vX.Y.Z or app-vX.Y.Z)" >&2; exit 2; }
  echo "$v"
}

# The newest version of LANE's tags in REFS (`git ls-remote`'s), or nothing.
newest_tag() {
  local prefix=v
  [ "$1" = app ] && prefix=app-v
  printf '%s\n' "$2" | sed -n "s|^[0-9a-f]*	refs/tags/$prefix\([0-9]*\.[0-9]*\.[0-9]*\)\$|\1|p" | sort -V | tail -1
}

# The daemon release's client fixtures (#200), as later daemons replay
# them: where they go, and the tag's own (crates/proto/fixtures/*.jsonl at
# SHA), `git ls-tree`'s lines.
fixtures_dir() { echo "crates/proto/fixtures/releases/$1"; }
tag_fixtures() { git ls-tree "$1" crates/proto/fixtures/ | awk -F'\t' '$1 ~ / blob / && $2 ~ /\.jsonl$/'; }

# fixtures_to_main TAG SHA V: after the tag is out, SHA's client fixtures
# into crates/proto/fixtures/releases/V on main, one commit on top of it,
# pushed straight there. The version-bump commit used to carry them; since
# #1986 there's none. The arugula-release deploy driver's token is the
# arugula-io App's, which the "binaries check" ruleset lets push to main;
# from a person's shell it's their own login. Built in a scratch index, so
# the checkout isn't touched. Skipped when main has that set already. When
# main moves under it, it tries again on the new main, a few times. It never
# fails the release, which is out already: it warns and says what to run.
fixtures_to_main() {
  local tag=$1 sha=$2 v=$3 dir entries how n main idx tree commit meta path err=''
  dir=$(fixtures_dir "$v")
  how="run \`just release-fixtures $v\` and merge it to main"
  entries=$(tag_fixtures "$sha")
  if [ -z "$entries" ]; then
    echo "warning: ${sha:0:12} has no crates/proto/fixtures/*.jsonl, so main gets no $dir; $how" >&2
    return 0
  fi
  idx=$(mktemp -d)/index
  for n in 1 2 3 4 5; do
    if ! err=$(git fetch -q "$url" main 2>&1); then continue; fi
    main=$(git rev-parse FETCH_HEAD)
    rm -f "$idx"
    GIT_INDEX_FILE=$idx git read-tree "$main"
    # Not --force-remove with xargs: BSD's and GNU's differ on no input.
    while IFS= read -r -d '' path; do
      GIT_INDEX_FILE=$idx git update-index --force-remove -- "$path"
    done < <(GIT_INDEX_FILE=$idx git ls-files -z -- "$dir")
    while IFS=$'\t' read -r meta path; do
      GIT_INDEX_FILE=$idx git update-index --add --cacheinfo "100644,$(echo "$meta" | cut -d' ' -f3),$dir/${path##*/}"
    done <<<"$entries"
    # --missing-ok: a partial clone (the driver's) has the trees, not every file.
    tree=$(GIT_INDEX_FILE=$idx git write-tree --missing-ok)
    if [ "$tree" = "$(git rev-parse "$main^{tree}")" ]; then
      echo "main has $dir already, as $tag has it"
      return 0
    fi
    commit=$(git commit-tree "$tree" -p "$main" -m "Fixtures: the client fixtures $tag shipped, in $dir (#200)")
    if err=$(git push -q "$url" "$commit:refs/heads/main" 2>&1); then
      echo "committed $dir to main (${commit:0:12})"
      return 0
    fi
  done
  echo "warning: main refused $dir (tried $n times). $tag is released all the same; $how" >&2
  [ -z "$err" ] || printf '%s\n' "$err" | sed 's/^/  git: /' >&2
  return 0
}

case "${1:-}" in
  check-version)
    # The daemon's release of TAG's version from TAG's commit, as it is: no
    # commit moves the version (#1986), so this checks what the commit has.
    # Not its client fixtures: `bump` commits those to main after the tag
    # (check-fixtures).
    tag=${2:?usage: release check-version TAG}
    tag_version "$tag" >/dev/null
    check_rare "$tag"
    ;;
  check-fixtures)
    # What this release's clients send and see, for later daemons to replay
    # (#200), on main once the release is out. Only ever a warning.
    tag=${2:?usage: release check-fixtures TAG}
    v=$(tag_version "$tag")
    dir=$(fixtures_dir "$v")
    if git fetch -q "$url" main && [ -n "$(git ls-tree --name-only FETCH_HEAD "$dir/")" ]; then
      echo "main has $dir"
    else
      msg="main has no $dir, the client fixtures $tag shipped (scripts/release bump commits them after the tag; that didn't go through): run \`just release-fixtures $v\` and merge it to main"
      echo "warning: $msg" >&2
      if [ -n "${GITHUB_ACTIONS:-}" ]; then echo "::warning::$msg"; fi
      if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then printf '### Client fixtures\n\n%s\n' "$msg" >>"$GITHUB_STEP_SUMMARY"; fi
    fi
    ;;
  stamp)
    # TAG's version into this checkout's files, before a build (#1986), as
    # chant's scripts/release-pack.sh does: the binaries carry it, and git
    # keeps what it had. Run again, it changes nothing more.
    tag=${2:?usage: release stamp TAG}
    v=$(tag_version "$tag")
    lane=$(tag_lane "$tag")
    old=$(version_at HEAD "$lane")
    [ -n "$old" ] || { echo "no version at HEAD to replace" >&2; exit 1; }
    apply_version "$lane" "$old" "$v"
    if [ "$lane" = app ]; then f=crates/desktop/Cargo.toml; else f=Cargo.toml; fi
    now=$(awk '/^\[/ { s = $0 } (s == "[workspace.package]" || s == "[package]") && /^version = "/ { print substr($0, 12, length($0) - 12); exit }' "$f")
    [ "$now" = "$v" ] || { echo "$f's version is $now after stamping $v" >&2; exit 1; }
    # The server's workspace carries the daemon's version.
    if [ "$lane" = daemon ] && [ -f server/Cargo.toml ]; then
      sv=$(awk '/^\[/ { s = $0 } s == "[workspace.package]" && /^version = "/ { print substr($0, 12, length($0) - 12); exit }' server/Cargo.toml)
      [ "$sv" = "$v" ] || { echo "server/Cargo.toml's version is $sv after stamping $v (it was not $old)" >&2; exit 1; }
    fi
    echo "stamped $tag: $old -> $v ($lane)"
    ;;
  check-green)
    check_green "$2" "${3:-}"
    ;;
  last-green)
    # What #308's server promote starts from: `last-green server`.
    lane=${2:-daemon}
    lane_tags "$lane"
    git fetch -q "$url" main
    ci=$(git ls-remote "$url" 'refs/tags/ci/*') || { echo "can't read the ci/ tags at $url" >&2; exit 1; }
    sha=$(newest_green "$lane" FETCH_HEAD "$ci")
    [ -n "$sha" ] || { echo "no commit among main's last 200 has a $green_tag tag without a $revoked_tag one" >&2; exit 1; }
    echo "$sha"
    ;;
  check-rare)
    check_rare "$2"
    ;;
  bump)
    # The newest green commit on main, tagged with the lane's next version
    # (#1986): the tag names the commit CI passed, as it is, and no commit
    # moves the version. For the daemon, the tag's client fixtures then go to
    # main in a commit of their own. The release workflow writes the version
    # into its build (`stamp`). Green is the lane's (#307): ci/green for the daemon,
    # ci/green-app for --app, the tags chant's `release cut --lane` reads.
    shift
    part=patch lane=daemon commit='' dry=0 older=0 start_rare=0
    for a in "$@"; do
      case "$a" in
        major|minor|patch) part=$a ;;
        --app) lane=app ;;
        --dry-run|-n) dry=1 ;;
        --older) older=1 ;;
        --rare) start_rare=1 ;;
        -*) echo "release bump: unknown flag $a" >&2; exit 2 ;;
        *) if [ -n "$commit" ]; then echo "release bump: two commits ($commit, $a)" >&2; exit 2; fi; commit=$a ;;
      esac
    done
    # The deploy that ran it (M221), as a trailer: one line, `Key: value`.
    trailer=${ARUGULA_RELEASE_TRAILER:-}
    case "$trailer" in
      *$'\n'*) echo "ARUGULA_RELEASE_TRAILER is one line" >&2; exit 2 ;;
      '') ;;
      *': '*) trailer=$'\n\n'$trailer ;;
      *) echo "ARUGULA_RELEASE_TRAILER is \`Key: value\`" >&2; exit 2 ;;
    esac
    git fetch -q "$url" main
    main=$(git rev-parse FETCH_HEAD)
    # The ci/ tags, read once; the lane's green and revoked tags.
    ci=$(git ls-remote "$url" 'refs/tags/ci/*') || { echo "can't read the ci/ tags at $url" >&2; exit 1; }
    lane_tags "$lane"
    is_green() {
      case "$ci" in *"refs/tags/$revoked_tag/$1"*) return 1 ;; *"refs/tags/$green_tag/$1"*) return 0 ;; *) return 1 ;; esac
    }
    if [ -n "$commit" ] && [ "$older" = 1 ]; then echo "release bump: COMMIT or --older, not both" >&2; exit 2; fi
    if [ -n "$commit" ]; then
      sha=$(git rev-parse --verify -q "$commit^{commit}") || { echo "$commit isn't a commit here" >&2; exit 1; }
      git merge-base --is-ancestor "$sha" "$main" || { echo "${sha:0:12} isn't on main" >&2; exit 1; }
      is_green "$sha" || { echo "${sha:0:12} has no $green_tag tag, or has a $revoked_tag one" >&2; exit 1; }
    else
      sha=$(newest_green "$lane" "$main" "$ci")
      [ -n "$sha" ] || { echo "no commit among main's last 200 has a $green_tag tag without a $revoked_tag one" >&2; exit 1; }
      skipped=$(git rev-list --first-parent --count "$sha..$main")
      # A release from an older commit leaves these out (#1679): say which,
      # and stop unless asked for it. A dry run lists them and goes on.
      if [ "$skipped" != 0 ]; then
        echo "$skipped newer commit(s) on main aren't green yet, so the release would leave out:"
        git log --first-parent --format='  %h %s' "$sha..$main"
        if [ "$older" = 0 ] && [ "$dry" = 0 ]; then
          echo "Wait for them to go green, or release ${sha:0:12} without them: \`just release --older\` (or name a COMMIT)." >&2
          exit 1
        fi
      fi
    fi
    # The next version after the lane's newest tag (or the commit's own
    # version, when it's higher: the versions files had before #1986).
    tags=$(git ls-remote "$url" "refs/tags/$( [ "$lane" = app ] && echo app-v || echo v)*") || { echo "can't read the tags at $url" >&2; exit 1; }
    at_sha=$(version_at "$sha" "$lane") at_tag=$(newest_tag "$lane" "$tags")
    cur=$(printf '%s\n' "$at_sha" "$at_tag" | sed '/^$/d' | sort -V | tail -1)
    new=$(next_version "$cur" "$part")
    if [ "$lane" = app ]; then tag=app-v$new notes=docs/releases/app-$new.md title="Arugula app $new"
    else tag=v$new notes=docs/releases/$new.md title="Arugula $new"; fi
    if printf '%s\n' "$tags" | grep -q "	refs/tags/$tag\$"; then echo "$tag already exists" >&2; exit 1; fi
    # Not a commit this lane already released.
    prefix=${tag%"$new"}
    last=$(printf '%s\n' "$tags" | sed -n "s|^\([0-9a-f]*\)	refs/tags/$prefix\([0-9.]*\)^{}\$|\2 \1|p" | sort -V | tail -1)
    if [ -n "$last" ]; then
      git fetch -q "$url" "${last#* }" 2>/dev/null || git fetch -q "$url" "refs/tags/$prefix${last% *}"
      if git merge-base --is-ancestor "$sha" "${last#* }"; then
        echo "${sha:0:12} is already released in $prefix${last% *}" >&2; exit 1
      fi
    fi
    # What the release needs in the commit itself: its notes, and for the
    # daemon the notes' headline section (the web client's What's new,
    # scripts/whats-new.mjs, read from the build). Not its client fixtures,
    # which go to main after the tag (fixtures_to_main). A dry run lists
    # what's missing.
    missing=()
    if ! git cat-file -e "$sha:$notes" 2>/dev/null; then
      missing+=("${sha:0:12} has no $notes: merge the release's notes, and release once that commit is green")
    elif [ "$lane" = daemon ] && ! git show "$sha:$notes" | grep -x "$headlines" >/dev/null; then
      missing+=("$notes has no headline section (a \`\`\`whats-new block, scripts/whats-new.mjs) at ${sha:0:12}")
    fi
    echo "$tag: ${cur:-none} -> $new on ${sha:0:12} ($(git log -1 --format=%s "$sha")), the newest green commit; main is at ${main:0:12}"
    if [ "${#missing[@]}" != 0 ]; then
      printf '%s\n' "${missing[@]}" >&2
      [ "$dry" = 1 ] || exit 1
    fi
    # A daemon release needs the rare jobs (#305) to have passed on the
    # commit too; --rare starts them and waits. A dry run only says.
    if [ "$lane" = daemon ]; then
      if rare "$sha"; then
        echo "${sha:0:12} passed the rare jobs (ci/rare/$sha)"
      elif [ "$dry" = 1 ]; then
        echo "${sha:0:12} has no ci/rare tag: the release needs the rare jobs to pass on it first (\`just release --rare\`)"
      elif [ "$start_rare" = 1 ]; then
        run_rare "$sha" || { echo "no release" >&2; exit 1; }
      else
        echo "${sha:0:12} has no ci/rare tag: the rare jobs ($rare_workflow) haven't passed on it. \`just release --rare\` starts them and waits, then releases" >&2
        exit 1
      fi
    fi
    if [ "$dry" = 1 ]; then
      if [ "$lane" = daemon ]; then
        echo "Dry run: would tag ${sha:0:12} $tag, push the tag, then commit its client fixtures to main as $(fixtures_dir "$new"); nothing tagged or pushed."
      else
        echo "Dry run: would tag ${sha:0:12} $tag and push the tag; nothing tagged or pushed."
      fi
      exit 0
    fi
    git tag -a "$tag" "$sha" -m "${title/Arugula/arugula}$trailer"
    if ! git push -q "$url" "refs/tags/$tag"; then
      git tag -d "$tag" >/dev/null
      echo "pushing $tag was refused: nothing was pushed; run it again" >&2
      exit 1
    fi
    # The arugula-release deploy driver (M221) reads this line (the last
    # that starts `pushed `).
    echo "pushed $tag (${sha:0:12})"
    # The daemon's client fixtures, which the release no longer needs in
    # its commit: onto main now (#200). Never a failure from here on.
    # (Called with ||, so set -e doesn't stop it part way: nothing it does
    # may fail the run now that the tag is out.)
    if [ "$lane" = daemon ]; then
      fixtures_to_main "$tag" "$sha" "$new" ||
        echo "warning: copying $tag's client fixtures to main failed; run \`just release-fixtures $new\` and merge it to main" >&2
    fi
    ;;
  sidecars)
    # From the latest daemon release (releases/latest), which this app then
    # carries for a machine with no daemon.
    target=$2; out=$3
    tag=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
    case "$tag" in v*) ;; *) echo "releases/latest is $tag, not a daemon release" >&2; exit 1 ;; esac
    v=${tag#v}
    case "$target" in *-windows-*) ext=zip ;; *) ext=tar.gz ;; esac
    name=arugula-$v-$target
    dir=$(mktemp -d)
    gh release download "$tag" -R "$repo" -p "$name.$ext" -p SHA256SUMS -D "$dir"
    want=$(awk -v f="$name.$ext" '$2 == f { print $1 }' "$dir/SHA256SUMS")
    [ -n "$want" ] || { echo "$name.$ext isn't in $tag's SHA256SUMS" >&2; exit 1; }
    if command -v sha256sum >/dev/null; then got=$(sha256sum "$dir/$name.$ext" | cut -d' ' -f1); else got=$(shasum -a 256 "$dir/$name.$ext" | cut -d' ' -f1); fi
    [ "$got" = "$want" ] || { echo "$name.$ext doesn't match $tag's SHA256SUMS" >&2; exit 1; }
    if [ "$ext" = zip ]; then
      powershell -NoProfile -Command "Expand-Archive -Force '$(cygpath -w "$dir/$name.zip")' '$(cygpath -w "$dir")'"
    else
      tar -xzf "$dir/$name.tar.gz" -C "$dir"
    fi
    mkdir -p "$out"
    for f in arugulad arugula arugulad.exe arugula.exe conpty.dll OpenConsole.exe ConPTY-LICENSE.txt; do
      [ ! -f "$dir/$name/$f" ] || cp "$dir/$name/$f" "$out/"
    done
    echo "$out: arugulad $v for $target, from $tag"
    "$out/arugulad" --version 2>/dev/null || true
    ;;
  sums)
    # SHA256SUMS of what the build jobs left in DIR, before `chant release
    # publish` attaches them with it; stops when one is missing.
    tag=${2:?usage: release sums TAG DIR}; dir=${3:?usage: release sums TAG DIR}
    case "$tag" in
      app-v*)
        for f in $(eval "echo $app_downloads"); do
          [ -f "$dir/$f" ] || { echo "the release has no $f" >&2; exit 1; }
        done
        (cd "$dir" && sha256sum -- arugula-desktop-* > SHA256SUMS && cat SHA256SUMS)
        ;;
      *)
        n=$(find "$dir" -name "arugula-[0-9]*.tar.gz" | wc -l | tr -d " ")
        [ "$n" = 4 ] || { echo "expected 4 tarballs, found $n" >&2; exit 1; }
        # Windows' zip (install.ps1's, M59).
        w=$(find "$dir" -name "arugula-[0-9]*-x86_64-pc-windows-msvc.zip" | wc -l | tr -d " ")
        [ "$w" = 1 ] || { echo "expected the Windows zip, found $w" >&2; exit 1; }
        (cd "$dir" && sha256sum -- arugula-[0-9]*.tar.gz arugula-[0-9]*.zip > SHA256SUMS && cat SHA256SUMS)
        ;;
    esac
    ;;
  draft)
    # Before `chant release publish` (#1986): TAG's release, made as a draft
    # with its title, and its notes from docs/releases/ as TAG's commit has
    # them (merged before the release). chant's forge target finds the draft,
    # attaches the files and publishes it, so the release appears whole.
    # A daemon release's notes leave out the headline section, which is the
    # web client's (What's new). A release that's out already is left alone.
    tag=${2:?usage: release draft TAG}
    ensure_release "$tag"
    if [ "$(gh release view "$tag" -R "$repo" --json isDraft --jq .isDraft)" != true ]; then
      echo "$tag's release is published already"; exit 0
    fi
    case "$tag" in app-v*) notes=docs/releases/app-${tag#app-v}.md ;; *) notes=docs/releases/${tag#v}.md ;; esac
    body=$(mktemp)
    if git show "$tag:$notes" >"$body" 2>/dev/null; then
      without_headlines <"$body" >"$body.out"
      gh release edit "$tag" -R "$repo" --notes-file "$body.out" >/dev/null
      echo "$tag's draft has the notes in $notes"
    else
      echo "$tag has no $notes: the draft keeps its default notes"
    fi
    rm -f "$body" "$body.out"
    ;;
  check-latest)
    check_latest
    ;;
  formula)
    # The formula's template for chant's homebrew target (release/daemon):
    # packaging/homebrew/arugula.rb.in with TAG's version in the tarballs'
    # names, so each {{url:NAME}} and {{sha256:NAME}} names a file the target
    # attaches. chant fills those and {{version}}, and commits the formula to
    # the tap. The tap's formula_renames.json (illogical -> arugula) is there
    # for good, and chant leaves it alone.
    tag=${2:?usage: release formula TAG DIR}; dir=${3:?usage: release formula TAG DIR}
    v=$(tag_version "$tag")
    mkdir -p "$dir"
    sed "s/@VERSION@/$v/g" packaging/homebrew/arugula.rb.in >"$dir/arugula.rb"
    echo "$dir/arugula.rb: the formula's template for $v"
    ;;
  blank)
    k=$(vers_kind "${2:?usage: release blank PATH}") || { echo "release blank: $2 isn't a Cargo.toml, Cargo.lock or THIRD_PARTY.md" >&2; exit 2; }
    vers blank "$k"
    ;;
  *)
    # The usage, down to the environment it reads.
    sed -n '2,/^# GH_TOKEN/p' "$0" | sed '$d' >&2
    exit 2
    ;;
esac

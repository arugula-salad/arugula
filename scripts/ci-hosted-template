#!/usr/bin/env bash
# The hosted workspace's image (M177, #1238): packaging/hosted's Dockerfile
# around a release's static arugulad and arugula. release.yml's `template`
# job publishes it as E2B's templates, one per workspace size (M266), each
# tagged with the release's tag: `arugula-workspace` (small: 2 vCPU, 2 GiB)
# and `arugula-workspace-large` (8 vCPU, 8 GiB), as E2B fixes a box's size
# when its template is built. The platform makes a workspace's box from
# `<its size's name>:vX.Y.Z` for its own version
# (crates/platform/src/compute/template.rs), so the tag is the record.
#
#   ci-hosted-template context DIR OUT   OUT: the build context, DIR's
#                                        arugulad and arugula (x86_64 musl,
#                                        `just static`) with packaging/hosted
#   ci-hosted-template image DIR [BASE]  build it with Docker as
#                                        arugula-workspace:local (BASE:
#                                        another base image, loam's e2b one)
#   ci-hosted-template publish TAG DIR   build it on E2B as
#                                        arugula-workspace:TAG and
#                                        arugula-workspace-large:TAG
#                                        (E2B_API_KEY); prints each template
#   ci-hosted-template dry-run TAG DIR   what publish would send E2B,
#                                        without a key or a build
#
# ARUGULA_TEMPLATE_NAME publishes under another name (a test's; large adds
# `-large` to it), ARUGULA_TEMPLATE_SIZES builds only some sizes (`small`,
# `large`, space-separated; both unless set), and ARUGULA_TEMPLATE_START
# starts another command than `arugula-hosted-start` (a test with a daemon
# from before it).
set -euo pipefail
cd "$(dirname "$0")/.."
here=packaging/hosted
name=${ARUGULA_TEMPLATE_NAME:-arugula-workspace}
sizes=${ARUGULA_TEMPLATE_SIZES:-small large}

# A size's template: its vCPUs, its memory in MiB and what its name adds.
# The platform's `Size` (crates/platform/src/compute/template.rs) has the
# same, and its test reads these lines. 8 and 8 GiB are the most E2B's
# Hobby plan builds (docs.e2b.dev/sandbox-template/customize-cpu-ram).
size_of() {
  case $1 in
  small) echo '2 2048' ;;
  large) echo '8 8192 -large' ;;
  *) echo "no such size: $1 (small or large)" >&2; return 1 ;;
  esac
}

# Each of $sizes, checked before anything is built: "SIZE CPUS MIB NAME".
plan() {
  local size cpus mib suffix
  for size in $sizes; do
    read -r cpus mib suffix < <(size_of "$size") || return 1
    echo "$size $cpus $mib $name$suffix"
  done
}

context() {
  local dir=${1:?usage: ci-hosted-template context DIR OUT} out=${2:?usage: ci-hosted-template context DIR OUT}
  mkdir -p "$out"
  cp "$here/Dockerfile" "$here/ready" "$here/start" "$here/arugulad.service" "$here/arugulad.json" "$out"/
  cp "$dir/arugulad" "$dir/arugula" "$out"/
  chmod +x "$out/arugulad" "$out/arugula" "$out/ready" "$out/start"
  file "$out/arugulad" | grep -q 'statically linked\|static-pie' || { echo "$dir/arugulad isn't a static binary (just static)" >&2; return 1; }
}

image() {
  local dir=${1:?usage: ci-hosted-template image DIR [BASE]} base=${2:-} ctx
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  if [ -n "$base" ]; then sed -i "0,/^FROM /s|^FROM .*|FROM $base|" "$ctx/Dockerfile"; fi
  docker build -t arugula-workspace:local "$ctx"
}

# The SDK's own pinned copy (package-lock.json).
sdk() {
  [ -d "$here/node_modules/e2b" ] || npm ci --prefix "$here" --no-fund --no-audit --silent
}

publish() {
  local tag=${1:?usage: ci-hosted-template publish TAG DIR} dir=${2:?usage: ci-hosted-template publish TAG DIR} ctx out todo size cpus mib as
  [ -n "${E2B_API_KEY:-}" ] || { echo "::error::E2B_API_KEY isn't set: the templates for $tag weren't built. Set the repository secret E2B_API_KEY and re-run this job." >&2; return 1; }
  todo=$(plan)
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  sdk
  while read -r size cpus mib as; do
    echo "building $as:$tag ($size: $cpus vCPU, $mib MiB)" >&2
    out=$(node "$here/template.mjs" "$ctx" "$as" "$tag" --cpus "$cpus" --memory-mb "$mib" ${ARUGULA_TEMPLATE_START:+--start "$ARUGULA_TEMPLATE_START"})
    echo "$out"
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
      jq -r --arg size "$size" '"E2B template `\(.template)` (\($size)): id \(.templateId), build \(.buildId)"' <<<"$out" >>"$GITHUB_STEP_SUMMARY"
    fi
  done <<<"$todo"
}

dry_run() {
  local tag=${1:?usage: ci-hosted-template dry-run TAG DIR} dir=${2:?usage: ci-hosted-template dry-run TAG DIR} ctx todo size cpus mib as
  todo=$(plan)
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  sdk
  while read -r size cpus mib as; do
    echo "would build $as:$tag ($size: $cpus vCPU, $mib MiB) from:" >&2
    env -u E2B_API_KEY node "$here/template.mjs" "$ctx" "$as" "$tag" --cpus "$cpus" --memory-mb "$mib" --dry-run ${ARUGULA_TEMPLATE_START:+--start "$ARUGULA_TEMPLATE_START"}
  done <<<"$todo"
}

case ${1:-} in
  context) shift; context "$@" ;;
  image) shift; image "$@" ;;
  publish) shift; publish "$@" ;;
  dry-run) shift; dry_run "$@" ;;
  *) sed -n '11,28p' "$0" >&2; exit 2 ;;
esac

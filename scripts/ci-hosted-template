#!/usr/bin/env bash
# The hosted workspace's image (M177, #1238): packaging/hosted's Dockerfile
# around a release's static arugulad and arugula. release.yml's `template`
# job publishes it as E2B's template `arugula-workspace`, tagged with the
# release's tag; the platform makes boxes from `arugula-workspace:vX.Y.Z`
# for its own version (crates/platform/src/compute/template.rs), so the
# tag is the record.
#
#   ci-hosted-template context DIR OUT   OUT: the build context, DIR's
#                                        arugulad and arugula (x86_64 musl,
#                                        `just static`) with packaging/hosted
#   ci-hosted-template image DIR [BASE]  build it with Docker as
#                                        arugula-workspace:local (BASE:
#                                        another base image, loam's e2b one)
#   ci-hosted-template publish TAG DIR   build it on E2B as
#                                        arugula-workspace:TAG (E2B_API_KEY);
#                                        prints the template
#   ci-hosted-template dry-run TAG DIR   what publish would send E2B,
#                                        without a key or a build
#
# ARUGULA_TEMPLATE_NAME publishes under another name (a test's), and
# ARUGULA_TEMPLATE_START starts another command than `arugulad --hosted`
# (a test with a daemon from before it).
set -euo pipefail
cd "$(dirname "$0")/.."
here=packaging/hosted
name=${ARUGULA_TEMPLATE_NAME:-arugula-workspace}

context() {
  local dir=${1:?usage: ci-hosted-template context DIR OUT} out=${2:?usage: ci-hosted-template context DIR OUT}
  mkdir -p "$out"
  cp "$here/Dockerfile" "$here/ready" "$here/arugulad.json" "$out"/
  cp "$dir/arugulad" "$dir/arugula" "$out"/
  chmod +x "$out/arugulad" "$out/arugula" "$out/ready"
  file "$out/arugulad" | grep -q 'statically linked\|static-pie' || { echo "$dir/arugulad isn't a static binary (just static)" >&2; return 1; }
}

image() {
  local dir=${1:?usage: ci-hosted-template image DIR [BASE]} base=${2:-} ctx
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  if [ -n "$base" ]; then sed -i "0,/^FROM /s|^FROM .*|FROM $base|" "$ctx/Dockerfile"; fi
  docker build -t arugula-workspace:local "$ctx"
}

# The SDK's own pinned copy (package-lock.json).
sdk() {
  [ -d "$here/node_modules/e2b" ] || npm ci --prefix "$here" --no-fund --no-audit --silent
}

publish() {
  local tag=${1:?usage: ci-hosted-template publish TAG DIR} dir=${2:?usage: ci-hosted-template publish TAG DIR} ctx out
  [ -n "${E2B_API_KEY:-}" ] || { echo "::error::E2B_API_KEY isn't set: the template for $tag wasn't built. Set the repository secret E2B_API_KEY and re-run this job." >&2; return 1; }
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  sdk
  out=$(node "$here/template.mjs" "$ctx" "$name" "$tag" ${ARUGULA_TEMPLATE_START:+--start "$ARUGULA_TEMPLATE_START"})
  echo "$out"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    jq -r '"E2B template `\(.template)`: id \(.templateId), build \(.buildId)"' <<<"$out" >>"$GITHUB_STEP_SUMMARY"
  fi
}

dry_run() {
  local tag=${1:?usage: ci-hosted-template dry-run TAG DIR} dir=${2:?usage: ci-hosted-template dry-run TAG DIR} ctx
  ctx=$(mktemp -d)
  # shellcheck disable=SC2064 # $ctx now, not at exit
  trap "rm -rf '$ctx'" EXIT
  context "$dir" "$ctx"
  sdk
  echo "would build $name:$tag from:" >&2
  env -u E2B_API_KEY node "$here/template.mjs" "$ctx" "$name" "$tag" --dry-run ${ARUGULA_TEMPLATE_START:+--start "$ARUGULA_TEMPLATE_START"}
}

case ${1:-} in
  context) shift; context "$@" ;;
  image) shift; image "$@" ;;
  publish) shift; publish "$@" ;;
  dry-run) shift; dry_run "$@" ;;
  *) sed -n '9,23p' "$0" >&2; exit 2 ;;
esac

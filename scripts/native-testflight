#!/usr/bin/env bash
# Uploads the iPhone and iPad app to TestFlight from geek: reads the App Store
# Connect API key from Infisical, archives and uploads on a Mac (jake-mini)
# through native/ios/testflight.sh, then waits for App Store Connect to process
# the build. The key signs too (cloud-managed signing), so the Mac needs no
# signing identity. The key is never written into the repo or a log: its
# .p8 goes over ssh's stdin to a file only this user can read, overwritten and
# removed when the upload ends.
#   scripts/native-testflight [upload|export] [REV] [HOST]
# REV (default origin/main) is checked out in HOST's ~/src/arugula-testflight.
# export signs the app for the App Store the same way and keeps the .ipa on
# HOST, without uploading. The secrets' names can be changed with ASC_KEY_ID_SECRET,
# ASC_ISSUER_ID_SECRET and ASC_KEY_P8_SECRET.
set -euo pipefail
mode=${1:-upload} rev=${2:-origin/main} host=${3:-jake-mini}
case "$mode" in upload|export) ;; *) echo "native-testflight: upload or export" >&2; exit 2 ;; esac
clone='~/src/arugula-testflight'
secret() {
  infisical secrets get "$1" --projectId 16bb0f03-4f52-4d75-aaa3-089323b66601 --env prod \
    --path "${ASC_SECRETS_PATH:-/illogical/release}" --plain --silent
}

ssh "$host" "set -e; export PATH=\$HOME/.local/bin:/opt/homebrew/bin:\$PATH
  [ -d $clone ] || git clone -q https://github.com/arugula-salad/arugula.git $clone
  cd $clone && git fetch -q origin && git checkout -q --detach $rev && mise trust -q . && git log --oneline -1"

key_id=$(secret "${ASC_KEY_ID_SECRET:-APPLE_ASC_KEY_ID}")
issuer=$(secret "${ASC_ISSUER_ID_SECRET:-APPLE_ASC_ISSUER_ID}")
p8=$(ssh "$host" 'umask 077; mktemp -t asc-key')
trap 'ssh "$host" "rm -P $p8 2>/dev/null || rm -f $p8"' EXIT
secret "${ASC_KEY_P8_SECRET:-APPLE_ASC_KEY_P8}" | ssh "$host" "cat > $p8"
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)

ssh "$host" "cd $clone && native/ios/testflight.sh $mode $key_id $issuer $p8"

[ "$mode" = upload ] || exit 0
# The build App Store Connect made of it: wait for TestFlight to process it.
secret "${ASC_KEY_P8_SECRET:-APPLE_ASC_KEY_P8}" | ASC_KEY_ID=$key_id ASC_ISSUER_ID=$issuer \
  python3 "$(dirname "$0")/native-testflight-wait.py" io.arugula.ios "$started"

  },
  "dependencies": {
    "@arugula/presence": "link:../client",
    "@arugula/presence-core": "link:../core",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  }
}

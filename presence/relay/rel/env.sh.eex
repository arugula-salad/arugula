#!/bin/sh
# The release's environment (#318's P2). On Fly, each machine is a node
# named after the app and its private IPv6 address, and nodes find each
# other through the app's .internal DNS (PresenceRelay.Application's
# DNSCluster). They share RELEASE_COOKIE, a Fly secret:
#   fly secrets set RELEASE_COOKIE=$(openssl rand -hex 32)
# Off Fly (a local `bin/presence_relay start`), nothing changes.
if [ -n "$FLY_APP_NAME" ]; then
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export ECTO_IPV6="true"
  export DNS_CLUSTER_QUERY="${DNS_CLUSTER_QUERY:-${FLY_APP_NAME}.internal}"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}"
fi

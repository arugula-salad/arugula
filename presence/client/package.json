{
  "name": "@arugula/presence",
  "version": "0.0.0",
  "private": true,
  "description": "Join a room and see who's around as live avatars or outlines: the client over a transport (arugula.video's Phoenix relay, or Arugula control's).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },

{
  "name": "arugula light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#1e2329",
    "focusBorder": "#374f04",
    "selection.background": "#374f0440",
    "widget.shadow": "#cad1db80",
    "editor.background": "#c9cfd8",
    "editor.foreground": "#1e2329",
    "editorCursor.foreground": "#374f04",
    "editor.selectionBackground": "#374f0440",
    "editor.inactiveSelectionBackground": "#89929f40",
    "editor.lineHighlightBackground": "#c1c9d5",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#89929f",
    "editorLineNumber.activeForeground": "#1e2329",
    "editorIndentGuide.background1": "#c1c9d5",
    "editorWhitespace.foreground": "#b4bbc7",
    "editorWidget.background": "#d2d8e1",
    "editorGroupHeader.tabsBackground": "#d2d8e1",
    "editorGroup.border": "#c1c9d5",
    "tab.activeBackground": "#c9cfd8",
    "tab.inactiveBackground": "#d2d8e1",
    "tab.activeForeground": "#1e2329",
    "tab.inactiveForeground": "#424c59",
    "tab.border": "#cad1db",
    "tab.activeBorderTop": "#374f04",
    "sideBar.background": "#d2d8e1",
    "sideBar.foreground": "#343c46",
    "sideBarSectionHeader.background": "#d2d8e1",
    "activityBar.background": "#cad1db",
    "activityBar.foreground": "#374f04",
    "activityBar.inactiveForeground": "#424c59",
    "activityBarBadge.background": "#374f04",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#cad1db",
    "titleBar.activeForeground": "#1e2329",
    "titleBar.inactiveBackground": "#cad1db",
    "statusBar.background": "#cad1db",
    "statusBar.foreground": "#343c46",
    "statusBar.noFolderBackground": "#cad1db",
    "panel.background": "#c9cfd8",
    "panel.border": "#c1c9d5",
    "list.activeSelectionBackground": "#c1c9d5",
    "list.activeSelectionForeground": "#1e2329",
    "list.inactiveSelectionBackground": "#c1c9d5",
    "list.hoverBackground": "#c1c9d580",
    "list.focusOutline": "#374f04",
    "input.background": "#c1c9d5",
    "input.foreground": "#1e2329",
    "dropdown.background": "#c1c9d5",
    "button.background": "#374f04",
    "button.foreground": "#ffffff",
    "badge.background": "#374f04",
    "badge.foreground": "#ffffff",
    "terminal.background": "#c9cfd8",
    "terminal.foreground": "#1e2329",
    "terminalCursor.foreground": "#374f04",
    "terminal.ansiBlack": "#c1c9d5",
    "terminal.ansiBrightBlack": "#89929f",
    "terminal.ansiRed": "#963730",
    "terminal.ansiBrightRed": "#8d1b19",
    "terminal.ansiGreen": "#03642c",
    "terminal.ansiBrightGreen": "#065d29",
    "terminal.ansiYellow": "#6b5105",
    "terminal.ansiBrightYellow": "#624903",
    "terminal.ansiBlue": "#02569a",
    "terminal.ansiBrightBlue": "#004e8d",
    "terminal.ansiMagenta": "#624496",
    "terminal.ansiBrightMagenta": "#593392",
    "terminal.ansiCyan": "#05606d",
    "terminal.ansiBrightCyan": "#025763",
    "terminal.ansiWhite": "#495462",
    "terminal.ansiBrightWhite": "#1e2329"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#424c59",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#374f04"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#02554c"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#065827"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#77316a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#7a3a01"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#224d7e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#704000"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8b2821"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#224d7e"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#343c46"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#343c46"
      }
    },
    {
      "scope": [
        "meta.macro",
        "entity.name.function.macro",
        "support.macro"
      ],
      "settings": {
        "foreground": "#8b2821"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#374f04",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#065827"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8b2821"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#8b2821"
      }
    }
  ]
}

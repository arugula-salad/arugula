{
  "name": "arugula",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#dbe4ec",
    "focusBorder": "#78ce57",
    "selection.background": "#78ce5740",
    "widget.shadow": "#050e1780",
    "editor.background": "#01080f",
    "editor.foreground": "#dbe4ec",
    "editorCursor.foreground": "#78ce57",
    "editor.selectionBackground": "#78ce5740",
    "editor.inactiveSelectionBackground": "#69748140",
    "editor.lineHighlightBackground": "#212b35",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#697481",
    "editorLineNumber.activeForeground": "#dbe4ec",
    "editorIndentGuide.background1": "#212b35",
    "editorWhitespace.foreground": "#303a44",
    "editorWidget.background": "#08121b",
    "editorGroupHeader.tabsBackground": "#08121b",
    "editorGroup.border": "#212b35",
    "tab.activeBackground": "#01080f",
    "tab.inactiveBackground": "#08121b",
    "tab.activeForeground": "#dbe4ec",
    "tab.inactiveForeground": "#9ba8b5",
    "tab.border": "#050e17",
    "tab.activeBorderTop": "#78ce57",
    "sideBar.background": "#08121b",
    "sideBar.foreground": "#bbc6d1",
    "sideBarSectionHeader.background": "#08121b",
    "activityBar.background": "#050e17",
    "activityBar.foreground": "#78ce57",
    "activityBar.inactiveForeground": "#9ba8b5",
    "activityBarBadge.background": "#78ce57",
    "activityBarBadge.foreground": "#172a11",
    "titleBar.activeBackground": "#050e17",
    "titleBar.activeForeground": "#dbe4ec",
    "titleBar.inactiveBackground": "#050e17",
    "statusBar.background": "#050e17",
    "statusBar.foreground": "#bbc6d1",
    "statusBar.noFolderBackground": "#050e17",
    "panel.background": "#01080f",
    "panel.border": "#212b35",
    "list.activeSelectionBackground": "#212b35",
    "list.activeSelectionForeground": "#dbe4ec",
    "list.inactiveSelectionBackground": "#212b35",
    "list.hoverBackground": "#212b3580",
    "list.focusOutline": "#78ce57",
    "input.background": "#212b35",
    "input.foreground": "#dbe4ec",
    "dropdown.background": "#212b35",
    "button.background": "#78ce57",
    "button.foreground": "#172a11",
    "badge.background": "#78ce57",
    "badge.foreground": "#172a11",
    "terminal.background": "#01080f",
    "terminal.foreground": "#dbe4ec",
    "terminalCursor.foreground": "#78ce57",
    "terminal.ansiBlack": "#212b35",
    "terminal.ansiBrightBlack": "#697481",
    "terminal.ansiRed": "#f98f84",
    "terminal.ansiBrightRed": "#fdb6ad",
    "terminal.ansiGreen": "#6fc884",
    "terminal.ansiBrightGreen": "#7ce695",
    "terminal.ansiYellow": "#d6aa42",
    "terminal.ansiBrightYellow": "#f6c343",
    "terminal.ansiBlue": "#72b6fe",
    "terminal.ansiBrightBlue": "#a3cffe",
    "terminal.ansiMagenta": "#bb9ef9",
    "terminal.ansiBrightMagenta": "#d1bffd",
    "terminal.ansiCyan": "#0ec7de",
    "terminal.ansiBrightCyan": "#0fe3fe",
    "terminal.ansiWhite": "#9ba8b5",
    "terminal.ansiBrightWhite": "#dbe4ec"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9ba8b5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#78ce57"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#25cbb7"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6fc884"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#e490d2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f2985f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8fb4dc"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#eea54a"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ec6c5f"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8fb4dc"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#bbc6d1"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#bbc6d1"
      }
    },
    {
      "scope": [
        "meta.macro",
        "entity.name.function.macro",
        "support.macro"
      ],
      "settings": {
        "foreground": "#ec6c5f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#78ce57",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6fc884"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ec6c5f"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ec6c5f"
      }
    }
  ]
}

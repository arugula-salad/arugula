{
  "name": "arugula",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#d6dee9",
    "focusBorder": "#56c8dc",
    "selection.background": "#56c8dc40",
    "widget.shadow": "#06090d80",
    "editor.background": "#0c1118",
    "editor.foreground": "#d6dee9",
    "editorCursor.foreground": "#56c8dc",
    "editor.selectionBackground": "#56c8dc40",
    "editor.inactiveSelectionBackground": "#3a465840",
    "editor.lineHighlightBackground": "#1a2230",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#3a4658",
    "editorLineNumber.activeForeground": "#d6dee9",
    "editorIndentGuide.background1": "#1a2230",
    "editorWhitespace.foreground": "#243042",
    "editorWidget.background": "#090d13",
    "editorGroupHeader.tabsBackground": "#090d13",
    "editorGroup.border": "#1a2230",
    "tab.activeBackground": "#0c1118",
    "tab.inactiveBackground": "#090d13",
    "tab.activeForeground": "#d6dee9",
    "tab.inactiveForeground": "#8b98ab",
    "tab.border": "#06090d",
    "tab.activeBorderTop": "#56c8dc",
    "sideBar.background": "#090d13",
    "sideBar.foreground": "#b4c0d0",
    "sideBarSectionHeader.background": "#090d13",
    "activityBar.background": "#06090d",
    "activityBar.foreground": "#56c8dc",
    "activityBar.inactiveForeground": "#8b98ab",
    "activityBarBadge.background": "#56c8dc",
    "activityBarBadge.foreground": "#06090d",
    "titleBar.activeBackground": "#06090d",
    "titleBar.activeForeground": "#d6dee9",
    "titleBar.inactiveBackground": "#06090d",
    "statusBar.background": "#06090d",
    "statusBar.foreground": "#b4c0d0",
    "statusBar.noFolderBackground": "#06090d",
    "panel.background": "#0c1118",
    "panel.border": "#1a2230",
    "list.activeSelectionBackground": "#1a2230",
    "list.activeSelectionForeground": "#d6dee9",
    "list.inactiveSelectionBackground": "#1a2230",
    "list.hoverBackground": "#1a223080",
    "list.focusOutline": "#56c8dc",
    "input.background": "#1a2230",
    "input.foreground": "#d6dee9",
    "dropdown.background": "#1a2230",
    "button.background": "#56c8dc",
    "button.foreground": "#06090d",
    "badge.background": "#56c8dc",
    "badge.foreground": "#06090d",
    "terminal.background": "#0c1118",
    "terminal.foreground": "#d6dee9",
    "terminalCursor.foreground": "#56c8dc",
    "terminal.ansiBlack": "#1a2230",
    "terminal.ansiBrightBlack": "#5c6a80",
    "terminal.ansiRed": "#f2778a",
    "terminal.ansiBrightRed": "#ff96a6",
    "terminal.ansiGreen": "#5fd394",
    "terminal.ansiBrightGreen": "#82e3ad",
    "terminal.ansiYellow": "#f0b45a",
    "terminal.ansiBrightYellow": "#ffcb7d",
    "terminal.ansiBlue": "#7aa7f0",
    "terminal.ansiBrightBlue": "#9dc0ff",
    "terminal.ansiMagenta": "#ad9cf2",
    "terminal.ansiBrightMagenta": "#c6b9ff",
    "terminal.ansiCyan": "#56c8dc",
    "terminal.ansiBrightCyan": "#84dceb",
    "terminal.ansiWhite": "#b4c0d0",
    "terminal.ansiBrightWhite": "#eef3f8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8b98ab", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#56c8dc" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#5fd3c4" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#5fd394" } },
    { "scope": ["constant.character.escape", "constant.regexp"], "settings": { "foreground": "#ad9cf2" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#f29b6b" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#7aa7f0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#f0b45a" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f2778a" } },
    { "scope": ["entity.name.tag", "meta.attribute", "entity.other.attribute-name"], "settings": { "foreground": "#7aa7f0" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#b4c0d0" } },
    { "scope": ["variable.other.property", "support.variable.property"], "settings": { "foreground": "#b4c0d0" } },
    { "scope": ["meta.macro", "entity.name.function.macro", "support.macro"], "settings": { "foreground": "#f2778a" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#56c8dc", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#5fd394" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f2778a" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f2778a" } }
  ]
}

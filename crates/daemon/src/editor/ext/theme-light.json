{
  "name": "arugula light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#4c4f69",
    "focusBorder": "#7330cb",
    "selection.background": "#acb0be80",
    "widget.shadow": "#dce0e880",
    "editor.background": "#eff1f5",
    "editor.foreground": "#4c4f69",
    "editorCursor.foreground": "#dc8a78",
    "editor.selectionBackground": "#acb0be80",
    "editor.inactiveSelectionBackground": "#9ca0b040",
    "editor.lineHighlightBackground": "#ccd0da",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#9ca0b0",
    "editorLineNumber.activeForeground": "#4c4f69",
    "editorIndentGuide.background1": "#ccd0da",
    "editorWhitespace.foreground": "#bcc0cc",
    "editorWidget.background": "#e6e9ef",
    "editorGroupHeader.tabsBackground": "#e6e9ef",
    "editorGroup.border": "#ccd0da",
    "tab.activeBackground": "#eff1f5",
    "tab.inactiveBackground": "#e6e9ef",
    "tab.activeForeground": "#4c4f69",
    "tab.inactiveForeground": "#56586a",
    "tab.border": "#dce0e8",
    "tab.activeBorderTop": "#7330cb",
    "sideBar.background": "#e6e9ef",
    "sideBar.foreground": "#56586f",
    "sideBarSectionHeader.background": "#e6e9ef",
    "activityBar.background": "#dce0e8",
    "activityBar.foreground": "#7330cb",
    "activityBar.inactiveForeground": "#56586a",
    "activityBarBadge.background": "#7330cb",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#dce0e8",
    "titleBar.activeForeground": "#4c4f69",
    "titleBar.inactiveBackground": "#dce0e8",
    "statusBar.background": "#dce0e8",
    "statusBar.foreground": "#56586f",
    "statusBar.noFolderBackground": "#dce0e8",
    "panel.background": "#eff1f5",
    "panel.border": "#ccd0da",
    "list.activeSelectionBackground": "#ccd0da",
    "list.activeSelectionForeground": "#4c4f69",
    "list.inactiveSelectionBackground": "#ccd0da",
    "list.hoverBackground": "#ccd0da80",
    "list.focusOutline": "#7330cb",
    "input.background": "#ccd0da",
    "input.foreground": "#4c4f69",
    "dropdown.background": "#ccd0da",
    "button.background": "#7330cb",
    "button.foreground": "#ffffff",
    "badge.background": "#7330cb",
    "badge.foreground": "#ffffff",
    "terminal.background": "#eff1f5",
    "terminal.foreground": "#4c4f69",
    "terminalCursor.foreground": "#dc8a78",
    "terminal.ansiBlack": "#5c5f77",
    "terminal.ansiBrightBlack": "#6c6f85",
    "terminal.ansiRed": "#d20f39",
    "terminal.ansiBrightRed": "#d20f39",
    "terminal.ansiGreen": "#40a02b",
    "terminal.ansiBrightGreen": "#40a02b",
    "terminal.ansiYellow": "#df8e1d",
    "terminal.ansiBrightYellow": "#df8e1d",
    "terminal.ansiBlue": "#1e66f5",
    "terminal.ansiBrightBlue": "#1e66f5",
    "terminal.ansiMagenta": "#ea76cb",
    "terminal.ansiBrightMagenta": "#ea76cb",
    "terminal.ansiCyan": "#179299",
    "terminal.ansiBrightCyan": "#179299",
    "terminal.ansiWhite": "#acb0be",
    "terminal.ansiBrightWhite": "#bcc0cc"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#56586a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#7330cb" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#106368" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#29661c" } },
    { "scope": ["constant.character.escape", "constant.regexp"], "settings": { "foreground": "#844272" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#993c07" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#1851c4" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#7d4f10" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b30d31" } },
    { "scope": ["entity.name.tag", "meta.attribute", "entity.other.attribute-name"], "settings": { "foreground": "#1851c4" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#56586f" } },
    { "scope": ["variable.other.property", "support.variable.property"], "settings": { "foreground": "#56586f" } },
    { "scope": ["meta.macro", "entity.name.function.macro", "support.macro"], "settings": { "foreground": "#b30d31" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7330cb", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#29661c" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#b30d31" } },
    { "scope": ["invalid"], "settings": { "foreground": "#b30d31" } }
  ]
}

{
  "name": "arugula mocha",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#cdd6f4",
    "focusBorder": "#cba6f7",
    "selection.background": "#585b7080",
    "widget.shadow": "#11111b80",
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editorCursor.foreground": "#f5e0dc",
    "editor.selectionBackground": "#585b7080",
    "editor.inactiveSelectionBackground": "#585b7040",
    "editor.lineHighlightBackground": "#313244",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#585b70",
    "editorLineNumber.activeForeground": "#cdd6f4",
    "editorIndentGuide.background1": "#313244",
    "editorWhitespace.foreground": "#45475a",
    "editorWidget.background": "#181825",
    "editorGroupHeader.tabsBackground": "#181825",
    "editorGroup.border": "#313244",
    "tab.activeBackground": "#1e1e2e",
    "tab.inactiveBackground": "#181825",
    "tab.activeForeground": "#cdd6f4",
    "tab.inactiveForeground": "#969aad",
    "tab.border": "#11111b",
    "tab.activeBorderTop": "#cba6f7",
    "sideBar.background": "#181825",
    "sideBar.foreground": "#a6adc8",
    "sideBarSectionHeader.background": "#181825",
    "activityBar.background": "#11111b",
    "activityBar.foreground": "#cba6f7",
    "activityBar.inactiveForeground": "#969aad",
    "activityBarBadge.background": "#cba6f7",
    "activityBarBadge.foreground": "#11111b",
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#11111b",
    "statusBar.background": "#11111b",
    "statusBar.foreground": "#a6adc8",
    "statusBar.noFolderBackground": "#11111b",
    "panel.background": "#1e1e2e",
    "panel.border": "#313244",
    "list.activeSelectionBackground": "#313244",
    "list.activeSelectionForeground": "#cdd6f4",
    "list.inactiveSelectionBackground": "#313244",
    "list.hoverBackground": "#31324480",
    "list.focusOutline": "#cba6f7",
    "input.background": "#313244",
    "input.foreground": "#cdd6f4",
    "dropdown.background": "#313244",
    "button.background": "#cba6f7",
    "button.foreground": "#11111b",
    "badge.background": "#cba6f7",
    "badge.foreground": "#11111b",
    "terminal.background": "#1e1e2e",
    "terminal.foreground": "#cdd6f4",
    "terminalCursor.foreground": "#f5e0dc",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiBrightMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightWhite": "#a6adc8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#969aad", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["constant.character.escape", "constant.regexp"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#fab387" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["entity.name.tag", "meta.attribute", "entity.other.attribute-name"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#a6adc8" } },
    { "scope": ["variable.other.property", "support.variable.property"], "settings": { "foreground": "#a6adc8" } },
    { "scope": ["meta.macro", "entity.name.function.macro", "support.macro"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#cba6f7", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f38ba8" } }
  ]
}

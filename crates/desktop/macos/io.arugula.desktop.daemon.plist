<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon as the app's launch agent (M46): registered by the app
     through SMAppService, running the arugulad inside the bundle. The
     same settings as `arugulad install`'s plist (install.rs).
     BundleProgram is relative to the bundle that registered it, so the
     agent runs this app's daemon wherever the app is (/Applications,
     ~/Applications) and under whichever name (an app from before the
     rename updates in place and stays illogical.app). M46 used a fixed
     /Applications path instead, as launchd refused BundleProgram for an
     ad-hoc signed app then ("The specified path is not a bundle"); with
     the Developer ID it runs (#177). If the app moves while the agent is
     loaded, launchd can't start it until the app registers it again
     (`start_agent` in main.rs). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.arugula.desktop.daemon</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/arugulad</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>io.arugula.desktop</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ARUGULA_KEEP_PANES</key>
    <string>true</string>
    <!-- launchd doesn't expand ~ in StandardOutPath; the daemon does here. -->
    <key>ARUGULA_LOG_FILE</key>
    <string>~/Library/Logs/arugulad.log</string>
  </dict>
  <key>ExitTimeOut</key>
  <integer>15</integer>
</dict>
</plist>

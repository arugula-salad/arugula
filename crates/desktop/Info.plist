<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by tauri build (M47).
     NSServices: Finder's "New Arugula Tab Here" for folders (finder.rs).
     NSPortName is the app's CFBundleName; the empty NSRequiredContext
     shows the service without enabling it in the keyboard settings first.
     CFBundleDocumentTypes: the app can open folders (a new tab there) and
     .command scripts (run in a new tab), as an alternate handler, so it
     never takes them from Terminal unless someone picks it.
     NSMicrophoneUsageDescription: a lent device's record_audio (S33,
     web/src/shell/hand.ts): an agent asks, the person allows it, the page
     records; and a People block's voice and calls (#1792).
     NSCameraUsageDescription: a People block's camera (its avatar or
     outline, and video in voice or a call, #1792). Without it macOS
     refuses the camera to the app's webviews. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Arugula uses the microphone when you talk in a People block's voice or a call, or when an agent asks this device to record audio and you allow it.</string>
  <key>NSCameraUsageDescription</key>
  <string>Arugula uses the camera when you turn it on in a People block: your avatar or outline, and your video in voice or a call.</string>
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>New Arugula Tab Here</string>
      </dict>
      <key>NSMessage</key>
      <string>newTabHere</string>
      <key>NSPortName</key>
      <string>arugula</string>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Folder</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Terminal shell script</string>
      <key>CFBundleTypeRole</key>
      <string>Shell</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.apple.terminal.shell-script</string>
      </array>
    </dict>
  </array>
</dict>
</plist>

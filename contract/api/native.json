{
  "scope": [
    "^/api/chat(/|$)",
    "^/api/projects(/|$)",
    "^/api/issues(/|$)",
    "^/api/boards(/|$)",
    "^/api/sessions(/|$)",
    "^/api/deploys(/|$)",
    "^/api/runs(/|$)",
    "^/api/inbox(/|$)"
  ],
  "out": [
    {
      "match": "/threads/{seq}/agents",
      "why": "The strip of a thread's agents is on the web for now (Arugula #646)"
    },
    {
      "match": "/secrets",
      "why": "Project secrets stay on the web"
    },
    {
      "match": "/clients",
      "why": "Registered clients are configured on the web"
    },
    {
      "match": "/agent-tokens",
      "why": "Agent tokens stay on the web"
    },
    {
      "match": "/inference",
      "why": "Inference keys and spend are billing and account matters"
    },
    {
      "match": "/trackers?(-writes)?(/|$)",
      "why": "Plane connections are configured on the web"
    },
    {
      "match": "/workspaces",
      "why": "Cloud workspace administration stays on the web for now"
    },
    {
      "match": "/run-specs",
      "why": "Run definitions are configured on the web"
    },
    {
      "match": "/environments",
      "why": "Deploy environments are configured on the web"
    },
    {
      "match": "/drivers",
      "why": "Deploy drivers are configured on the web"
    },
    {
      "match": "/repos",
      "why": "Linking repos is configured on the web"
    },
    {
      "match": "/transcripts",
      "why": "Not in the first app"
    },
    {
      "match": "/board-settings",
      "why": "Board settings are configured on the web"
    },
    {
      "match": "/issue-home",
      "why": "Issue home is configured on the web"
    },
    {
      "match": "/issues/export",
      "why": "Exporting issues is a web task"
    },
    {
      "match": "/sessions/settings",
      "why": "Session settings are configured on the web"
    },
    {
      "match": "/sessions/stats",
      "why": "Not in the first app"
    },
    {
      "match": "/relations",
      "why": "Not in the first app"
    },
    {
      "match": "/artifacts",
      "why": "Run artifacts are downloads, not in the first app"
    },
    {
      "match": "/projects/\\{project\\}/runs$",
      "why": "Starting runs is not in the first app"
    },
    {
      "match": "/projects/\\{project\\}/runs/start$",
      "why": "Starting runs is not in the first app"
    },
    {
      "match": "/projects/\\{project\\}/deploys$",
      "why": "Planning deploys is not in the first app; approving one is"
    },
    {
      "match": "/deploys/\\{id\\}/request$",
      "why": "Requesting deploys is not in the first app; approving one is"
    },
    {
      "match": "/chat/teams/\\{team\\}/(settings|previews)$",
      "why": "Team chat settings stay on the web"
    },
    {
      "match": "/chat/presence/token$",
      "why": "Live presence is not in the first app"
    },
    {
      "match": "/chat/presence$",
      "why": "Live presence is not in the first app"
    }
  ],

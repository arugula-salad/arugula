        "review_requested": {
          "default": null,
          "description": "A GitHub login among the requested reviewers.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "default": null,
          "description": "`open`, `closed` or `merged`.",
          "type": [
            "string",
            "null"
          ]

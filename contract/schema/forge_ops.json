          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "type": "string"
        },
        "repo": {
          "description": "`OWNER/NAME`.",
          "type": "string"
        },
        "repo_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sent_at": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]

{
  "$defs": {
    "Arch": {
      "anyOf": [
        {
          "enum": [
            "x86_64",
            "aarch64",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ]
    },
    "FailedCall": {
      "description": "An Arugula tool call that failed: which, and what it said. Never its\narguments.",
      "properties": {
        "error": {
          "description": "Its error, at most [`MAX_ERROR`] bytes. Untrusted.",
          "type": "string"
        },
        "kind": {
          "default": null,
          "description": "Its kind, for a tool that has kinds (`issue`).",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "The tool (`forge_read`) or CLI command (`arugula run`).",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "error"
      ],
      "type": "object"
    },
    "FeedbackAck": {
      "description": "A send taken.",
      "properties": {
        "id": {
          "description": "`fbk_…` ([`ID_PREFIX`]).",
          "type": "string"
        },
        "shown": {
          "description": "What people are shown for it: `F-` and a short form (`F-7K2Q9X`).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "shown"
      ],
      "type": "object"
    },
    "FeedbackAgent": {
      "description": "The agent that wrote it, as it says: each at most [`MAX_SHORT`].\nUntrusted.",
      "properties": {
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "`claude-code`, `codex`.",
          "type": "string"
        },
        "version": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "FeedbackContext": {
      "description": "Where the sender was. The daemon fills it in for the CLI and MCP, the\nweb client for itself; each field is left out when not known.",
      "properties": {
        "arch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Arch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failed": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailedCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last Arugula tool call that failed for the sender, if one did."
        },
        "onboarding": {
          "default": null,
          "description": "How far through getting started the sender is: a step's name\n(letters, digits, `-` and `_`).",
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "anyOf": [
            {
              "$ref": "#/$defs/Os"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "default": null,
          "description": "The web client's route, without its query or fragment.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "default": null,
          "description": "Arugula's version: the daemon's, or the web client's.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FeedbackKind": {
      "anyOf": [
        {
          "oneOf": [
            {
              "enum": [
                "idea",
                "praise",
                "other"
              ],
              "type": "string"
            },
            {
              "const": "bug",
              "description": "Something doesn't work.",
              "type": "string"
            },
            {
              "const": "missing",
              "description": "Something isn't there.",
              "type": "string"
            }
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "What it is."
    },
    "FeedbackRefused": {
      "description": "A send refused (the status each reason has is beside it).",
      "properties": {
        "difficulty": {
          "default": null,
          "description": "The difficulty control asks, with [`POW_MISSING`] and [`POW_BAD`].",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "description": "[`RATE_LIMITED`], [`ANONYMOUS_OFF`], [`TOO_LARGE`], [`POW_MISSING`]\nor [`POW_BAD`]; another is a reason this side doesn't know yet.",
          "type": "string"
        },
        "retry_after": {
          "default": null,
          "description": "When to try again (seconds), with [`RATE_LIMITED`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "FeedbackSource": {
      "anyOf": [
        {
          "oneOf": [
            {
              "enum": [
                "person",
                "other"
              ],
              "type": "string"
            },
            {
              "const": "agent",
              "description": "An agent, through the MCP tool or the CLI.",
              "type": "string"
            }
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FeedbackStamp": {
      "description": "The proof of work for an anonymous send (the module's doc says how).",
      "properties": {
        "difficulty": {
          "description": "The leading zero bits it was solved for.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "nonce": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "difficulty",
        "nonce"
      ],
      "type": "object"
    },
    "FeedbackSubmit": {
      "description": "What someone sends.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackAgent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent that wrote it, when an agent did and says."
        },
        "body": {
          "default": "",
          "description": "At most [`MAX_BODY`] bytes; may be empty. Untrusted.",
          "type": "string"
        },
        "contact_ok": {
          "default": false,
          "description": "Whether the sender may be contacted about it: a signed-in account\nby its email, a joined machine by its owner's.",
          "type": "boolean"
        },
        "context": {
          "$ref": "#/$defs/FeedbackContext",
          "default": {
            "arch": null,
            "failed": null,
            "onboarding": null,
            "os": null,
            "route": null,
            "version": null
          }
        },
        "kind": {
          "$ref": "#/$defs/FeedbackKind"
        },
        "source": {
          "$ref": "#/$defs/FeedbackSource",
          "description": "Who wrote it."
        },
        "surface": {
          "$ref": "#/$defs/FeedbackSurface",
          "description": "Where it was sent from."
        },
        "title": {
          "description": "At most [`MAX_TITLE`] characters, not empty. Untrusted.",
          "type": "string"
        },
        "who": {
          "$ref": "#/$defs/FeedbackWho",
          "default": {
            "install": null,
            "stamp": null
          }
        }
      },
      "required": [
        "kind",
        "title",
        "source",
        "surface"
      ],
      "type": "object"
    },
    "FeedbackSurface": {
      "anyOf": [
        {
          "enum": [
            "mcp",
            "cli",
            "web",
            "desktop",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ]
    },
    "FeedbackWho": {
      "description": "An anonymous send's: an install id and its stamp. Empty on a signed\nsend, whose signature or session says who it's from.",
      "properties": {
        "install": {
          "default": null,
          "description": "Random, 16 lowercase hex digits, the install's own: telemetry's when\nit has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackStamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "Os": {
      "anyOf": [
        {
          "enum": [
            "linux",
            "macos",
            "windows",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "arugula_control_wire::feedback"
}

{
  "$defs": {
    "BlockClaims": {
      "description": "A block grant's claims (#1001): a machine token's, narrowed to one\nblock and bound to one key. A frame on a block's origin shows that\nblock, and nothing else on the machine.",
      "properties": {
        "aud": {
          "description": "The machine's id.",
          "type": "string"
        },
        "block": {
          "description": "The block's pane id, in decimal.",
          "type": "string"
        },
        "exp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "iat": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "iss": {
          "description": "The hub's public URL.",
          "type": "string"
        },
        "jti": {
          "type": "string"
        },
        "key": {
          "description": "The one-off key (X25519, hex) the grant is for: the daemon refuses\nit from a handshake with any other static key.",
          "type": "string"
        },
        "name": {
          "description": "The account's login, to show.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/TokenRole",
          "description": "The account's role on the machine when the grant was made. A block\nshows whatever its port does, so the daemon lets in only a role it\nwould let in as its owner."
        },
        "sub": {
          "description": "The account's id.",
          "type": "string"
        },
        "use": {
          "description": "Always [`BLOCK_USE`].",
          "type": "string"
        }
      },
      "required": [
        "iss",
        "sub",
        "aud",
        "use",
        "role",
        "name",
        "block",
        "key",
        "iat",
        "exp",
        "jti"
      ],
      "type": "object"
    },
    "BlockGrantRequest": {
      "description": "What a page asks the hub for a block grant with: the block, and the\none-off key its frame will open the channel with.",
      "properties": {
        "block": {
          "description": "The block's pane id on the machine, in decimal.",
          "type": "string"
        },
        "key": {
          "description": "The frame's one-off X25519 key, the public half, in hex: the static\nkey of the channel's handshake.",
          "type": "string"
        }
      },
      "required": [
        "block",
        "key"
      ],
      "type": "object"
    },
    "BlockGrantResponse": {
      "description": "The hub's answer to a block grant request.",
      "properties": {
        "expires": {
          "description": "When it runs out, in seconds since the epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token",
        "expires"
      ],
      "type": "object"
    },
    "BlockTokenHello": {
      "additionalProperties": false,
      "description": "The payload of a block channel's first message when its grant is the\nhub's rather than one a device signed (`{\"grant\": …}`).",
      "properties": {
        "block_token": {
          "type": "string"
        }
      },
      "required": [
        "block_token"
      ],
      "type": "object"
    },
    "Jwk": {
      "description": "One public key, as a JWKS lists it.",
      "properties": {
        "alg": {
          "type": [
            "string",
            "null"
          ]
        },
        "crv": {
          "type": "string"
        },
        "kid": {
          "type": "string"
        },
        "kty": {
          "type": "string"
        },
        "use": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "type": "string"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "kid"
      ],
      "type": "object"
    },
    "Jwks": {
      "description": "`/.well-known/jwks.json`.",
      "properties": {
        "keys": {
          "items": {
            "$ref": "#/$defs/Jwk"
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "type": "object"
    },
    "MachineClaims": {
      "description": "A machine token's claims.",
      "properties": {
        "aud": {
          "description": "The machine's id.",
          "type": "string"
        },
        "exp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "from": {
          "description": "The machine that asked, for a machine's token\n([`TokenRole::is_machine`]): its id, to show who called.",
          "type": [
            "string",
            "null"
          ]
        },
        "iat": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "iss": {
          "description": "The hub's public URL.",
          "type": "string"
        },
        "jti": {
          "description": "Unique to this token: a daemon takes each one once.",
          "type": "string"
        },
        "name": {
          "description": "The account's login, to show.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/TokenRole"
        },
        "sub": {
          "description": "The account's id.",
          "type": "string"
        },
        "use": {
          "description": "Always [`USE`].",
          "type": "string"
        }
      },
      "required": [
        "iss",
        "sub",
        "aud",
        "use",
        "role",
        "name",
        "iat",
        "exp",
        "jti"
      ],
      "type": "object"
    },
    "MachineTokenResponse": {
      "description": "The hub's answer to `POST /api/machines/{id}/token`.",
      "properties": {
        "expires": {
          "description": "When it runs out, in seconds since the epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/TokenRole"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token",
        "expires",
        "role"
      ],
      "type": "object"
    },
    "TokenHello": {
      "additionalProperties": false,
      "description": "The payload of a channel's first message when it opens with a machine\ntoken rather than a device key.",
      "properties": {
        "machine_token": {
          "type": "string"
        }
      },
      "required": [
        "machine_token"
      ],
      "type": "object"
    },
    "TokenRole": {
      "description": "What the token lets its holder do on the machine, as the hub saw it when\nit made the token.",
      "oneOf": [
        {
          "const": "owner",
          "description": "The machine's owner, or an owner of its team.",
          "type": "string"
        },
        {
          "const": "editor",
          "description": "An editor in the machine's team.",
          "type": "string"
        },
        {
          "const": "viewer",
          "description": "A viewer in the machine's team.",
          "type": "string"
        },
        {
          "const": "guest",
          "description": "Anyone else signed in: they reach only sessions shared with them.",
          "type": "string"
        },
        {
          "const": "agents",
          "description": "Another machine of a person who may call this one's agents (#399,\nArugula #1002): requests under `/api/a2a/` and nothing else, as\ntheir account. Asked for by a daemon ([`machine_token_path`]), never\na person.",
          "type": "string"
        },
        {
          "const": "drives",
          "description": "Another machine of a person with full use of this hosted one (M184,\nArugula #1002): every request, as its owner. Only a hosted machine\ntakes it; anywhere else it's [`TokenRole::Agents`].",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "arugula_control_wire::machine_token"
}

{
  "$defs": {
    "AttachRole": {
      "description": "What an attachment is for.",
      "oneOf": [
        {
          "const": "work",
          "description": "The work itself: a PR, an agent block or a run. It moves the lane.",
          "type": "string"
        },
        {
          "const": "proof",
          "description": "Evidence that the work is done: a run or a link.",
          "type": "string"
        }
      ]
    },
    "AttachRow": {
      "description": "[`BOARD_ATTACHMENTS`]' body: attach `pointer` to `row` as `role`.",
      "properties": {
        "pointer": {
          "$ref": "#/$defs/Pointer"
        },
        "role": {
          "$ref": "#/$defs/AttachRole"
        },
        "row": {
          "description": "The row (`row_…`).",
          "type": "string"
        }
      },
      "required": [
        "row",
        "pointer",
        "role"
      ],
      "type": "object"
    },
    "Attachment": {
      "description": "Something attached to a row.",
      "properties": {
        "block": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockState"
            },
            {
              "type": "null"
            }
          ],
          "description": "A `Block` pointer's block as its machine last reported it."
        },
        "id": {
          "description": "`att_` and 32 hex characters.",
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/Live"
            },
            {
              "type": "null"
            }
          ],
          "description": "The item's state now, when the reader may see it: an item they can't\nread says nothing, as an unreadable row does."
        },
        "pointer": {
          "$ref": "#/$defs/Pointer"
        },
        "role": {
          "$ref": "#/$defs/AttachRole"
        }
      },
      "required": [
        "id",
        "role",
        "pointer"
      ],
      "type": "object"
    },
    "BlockState": {
      "additionalProperties": false,
      "description": "What a daemon says of one of its own agent blocks, and all it says\n(aru-116's second ruling): the state word, the branch, the short HEAD,\nwhether it is pushed, how many files are uncommitted and the diffstat.\nNo message text, no file names, no prompts: the type has no field that\ncould carry them, and a body with another field is refused.",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diffstat"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "description": "HEAD, abbreviated.",
          "type": [
            "string",
            "null"
          ]
        },
        "pushed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/BlockWord"
        },
        "uncommitted": {
          "description": "How many files are uncommitted.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "BlockWord": {
      "description": "What an agent block is doing (aru-116's second ruling).",
      "enum": [
        "working",
        "needs_input",
        "idle",
        "closed"
      ],
      "type": "string"
    },
    "Board": {
      "properties": {
        "closed_at": {
          "default": null,
          "description": "When it was closed; absent while it is open.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "closed_by": {
          "default": "",
          "description": "The account that closed it; empty once that account is deleted. When\nan agent closed it, the account it acted for.",
          "type": "string"
        },
        "closed_by_agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatAgent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The machine whose agent closed it, if one did."
        },
        "created_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "created_by": {
          "description": "The account that made it; empty once that account is deleted. When an\nagent made it, the account it acted for.",
          "type": "string"
        },
        "created_by_agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatAgent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The machine whose agent made it, if one did."
        },
        "done_note": {
          "default": "",
          "description": "What was done, written when the board was closed; kept when it is\nopened again. Empty before it was ever closed.",
          "type": "string"
        },
        "goal": {
          "default": "",
          "description": "What the board is for, in a paragraph; empty means none.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/BoardProgress",
          "default": {
            "done": 0,
            "proven": 0,
            "total": 0
          },
          "description": "How many of its issues are closed."
        },
        "project": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "project",
        "title",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "BoardList": {
      "properties": {
        "boards": {
          "items": {
            "$ref": "#/$defs/Board"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "boards"
      ],
      "type": "object"
    },
    "BoardProgress": {
      "description": "A board's work, counted: the rows with a primary item (an issue or a\nPR; a note row is never counted). `done` is those in the Done lane, and\n`proven` those of them with a proof.",
      "properties": {
        "done": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "proven": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "type": "object"
    },
    "BoardReach": {
      "description": "[`AGENT_BOARD_REACH`]'s answer.",
      "properties": {
        "projects": {
          "items": {
            "$ref": "#/$defs/BoardReachProject"
          },
          "type": "array"
        }
      },
      "required": [
        "projects"
      ],
      "type": "object"
    },
    "BoardReachProject": {
      "description": "A project a machine's board grants reach, as its owner reads it now.",
      "properties": {
        "boards": {
          "description": "How many boards it has.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "powers": {
          "description": "`boards.read`, `boards.write`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "powers",
        "boards"
      ],
      "type": "object"
    },
    "BoardView": {
      "description": "A board with its four lanes, in order (`lane_next`, `lane_doing`,\n`lane_review`, `lane_done`), each with its rows, and its groups, in\norder. The rows of a group are those with [`Row::group`] set to its id; a\nrow without one comes after the grouped ones.",
      "properties": {
        "board": {
          "$ref": "#/$defs/Board"
        },
        "groups": {
          "default": [],
          "description": "Empty for a board with none; an old client ignores it.",
          "items": {
            "$ref": "#/$defs/Group"
          },
          "type": "array"
        },
        "said": {
          "description": "What a write did that the board alone doesn't say: a PR attached to\nthe row of the issue it closes, an item that was there already.",
          "type": [
            "string",
            "null"
          ]
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "type": "array"
        }
      },
      "required": [
        "board",
        "zones"
      ],
      "type": "object"
    },
    "ChatAgent": {
      "description": "The agent that wrote a message (M197): the machine whose grant it acted\nthrough, and its name now. The message's author is the machine's owner.",
      "properties": {
        "machine": {
          "type": "string"
        },
        "machine_name": {
          "type": "string"
        }
      },
      "required": [
        "machine",
        "machine_name"
      ],
      "type": "object"
    },
    "CloseBoard": {
      "description": "`POST` to close a board: what was done, not empty.",
      "properties": {
        "done_note": {
          "type": "string"
        }
      },
      "required": [
        "done_note"
      ],
      "type": "object"
    },
    "Diffstat": {
      "additionalProperties": false,
      "description": "A `git diff --stat` summary line as numbers: nothing of the files.",
      "properties": {
        "added": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "added",
        "removed"
      ],
      "type": "object"
    },
    "EditBoard": {
      "description": "`PATCH`: what to change; a field left out stays. An empty goal clears it.",
      "properties": {
        "goal": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EntryKind": {
      "description": "Zone (a group, in a database; a lane, on the wire) or row.",
      "enum": [
        "zone",
        "row"
      ],
      "type": "string"
    },
    "Group": {
      "description": "A named, ordered section of a board that its author sets: a phase, a\nwave, an area. A row belongs to at most one ([`Row::group`]); a group\nholds no lane, and a row's lane is the same in any group.",
      "properties": {
        "id": {
          "description": "`zon_…`.",
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/BoardProgress",
          "default": {
            "done": 0,
            "proven": 0,
            "total": 0
          },
          "description": "Its rows with an issue or a PR, counted as a board's are."
        },
        "rev": {
          "description": "Counts changes to its title.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rev",
        "title"
      ],
      "type": "object"
    },
    "Lane": {
      "description": "Where a row is, worked out on every read from the live state of its\nitems and never stored (aru-125). Each is the furthest that applies, in\nthe order `done`, `review`, `doing`, `next`.",
      "oneOf": [
        {
          "const": "next",
          "description": "Nothing is under way, or the row is a note.",
          "type": "string"
        },
        {
          "const": "doing",
          "description": "An agent block that isn't closed, or a run that is running.",
          "type": "string"
        },
        {
          "const": "review",
          "description": "A PR is open, or the issue is open and its PR merged (see\n[`Mark::MergedNotClosed`]).",
          "type": "string"
        },
        {
          "const": "done",
          "description": "The issue is closed, or the PR merged or closed.",
          "type": "string"
        }
      ]
    },
    "Live": {
      "description": "The item a row points at, as it is now: what the page draws beside the\nrow's own status, and the label of its link.",
      "properties": {
        "assignees": {
          "description": "Who an issue or PR is assigned to: a mirrored item's logins, a native\nissue's names. A run has none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "identifier": {
          "description": "A tracker item's project key (`ARUGU`: the card reads `ARUGU-12`).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`pr` or `issue` (a mirrored one), `native` for a native issue, or\n`run`.",
          "type": "string"
        },
        "number": {
          "description": "A run has none: 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "description": "`plane` for a tracker's item; absent for GitHub, native issues and runs.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "`OWNER/NAME` of a mirrored item; absent for a native issue.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/LiveState"
        },
        "state_name": {
          "description": "A tracker item's own state (`In Progress`).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "A run's: how it started (`manual run`).",
          "type": "string"
        },
        "url": {
          "description": "Where a tracker item is, in the tracker.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "kind",
        "number",
        "title"
      ],
      "type": "object"
    },
    "LiveState": {
      "description": "What a pointer to an item, an issue or a run is now, from data control\nalready has (the forge mirror, the issues and runs tables): a separate fact, never written\nover the row's stored `status`.",
      "oneOf": [
        {
          "enum": [
            "merged",
            "succeeded"
          ],
          "type": "string"
        },
        {
          "const": "open",
          "description": "A PR or an issue, open.",
          "type": "string"
        },
        {
          "const": "checks_running",
          "description": "A PR, open, with checks still running.",
          "type": "string"
        },
        {
          "const": "checks_failed",
          "description": "A PR, open, with red checks.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "A PR closed unmerged, or an issue closed.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "A run, running.",
          "type": "string"
        },
        {
          "const": "run_failed",
          "description": "A run that failed.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A run that is pending, approved, denied, canceled or expired.",
          "type": "string"
        }
      ]
    },
    "Mark": {
      "description": "A note on a row that its lane doesn't say, worked out on every read and\nnever stored (aru-125, decisions 7 to 9).",
      "oneOf": [
        {
          "description": "The issue is open and a PR of the row merged, with none open: the\nwork is in, the issue isn't closed. The row is in Review.",
          "properties": {
            "kind": {
              "const": "merged_not_closed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An open PR of the row is stacked on another open PR: it targets that\nPR's branch, so it waits for it. `repo` is left out when the reader\nmay not read the repo.",
          "properties": {
            "kind": {
              "const": "after",
              "type": "string"
            },
            "number": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "repo": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "number"
          ],
          "type": "object"
        },
        {
          "description": "An agent block attached to the row (`attachment`) was closed, and\nanother may have taken its place: it no longer counts toward Doing.",
          "properties": {
            "attachment": {
              "type": "string"
            },
            "kind": {
              "const": "earlier",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "attachment"
          ],
          "type": "object"
        }
      ]
    },
    "MoveEntry": {
      "description": "[`BOARD_ENTRY_MOVE`]'s body. A row moves to a group (`zone`) or, with\n`zone: null`, out of its group; with `zone` absent it stays where it is.\nIt goes before `before` (a row of the place it goes to), last without\none. A group moves among groups:\n`before` is a group, `zone` is absent. A lane is never set (aru-125): a\n`zone` that is a lane is refused.",
      "properties": {
        "before": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "zone": {
          "description": "The group the row goes to; `null`: none. Absent: its own.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NewBoard": {
      "properties": {
        "goal": {
          "description": "What the board is for; left out: none.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Pointer": {
      "description": "What a row points at. `None` is free text. The ids are the platform's:\n`fi_…` (a mirrored PR or issue), `iss_…`, `run_…`, `hw_…`.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "forge_item",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "issue",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "workspace",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "An agent block on a machine.",
          "properties": {
            "kind": {
              "const": "block",
              "type": "string"
            },
            "machine": {
              "type": "string"
            },
            "pane": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "machine",
            "pane"
          ],
          "type": "object"
        },
        {
          "description": "An `https://` URL, as evidence (a CI page, a report). The platform\ntakes only `https`, no userinfo, at most [`LINK_MAX`] bytes.",
          "properties": {
            "kind": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        }
      ]
    },
    "Proof": {
      "description": "The mark on a Done row that is proven. A Done row without one is not\nproven yet.",
      "properties": {
        "by": {
          "$ref": "#/$defs/ProofBy"
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pointer"
            },
            {
              "type": "null"
            }
          ],
          "description": "What proves it: the merged PR, or the evidence attached."
        }
      },
      "required": [
        "by"
      ],
      "type": "object"
    },
    "ProofBy": {
      "description": "How a Done row is proven.",
      "oneOf": [
        {
          "const": "ci",
          "description": "A PR of the row merged with every check on its head completed and\nnone red.",
          "type": "string"
        },
        {
          "const": "evidence",
          "description": "A `proof` attachment.",
          "type": "string"
        }
      ]
    },
    "PutBlockState": {
      "additionalProperties": false,
      "description": "[`AGENT_BLOCK_STATE`]'s body: the pane (of the machine that signs it) and\nits state.",
      "properties": {
        "block": {
          "$ref": "#/$defs/BlockState"
        },
        "pane": {
          "type": "string"
        }
      },
      "required": [
        "pane",
        "block"
      ],
      "type": "object"
    },
    "PutEntry": {
      "description": "[`BOARD_ENTRIES`]' body. Without `id` it adds a row, last (`entry` is\n`row` or absent), or, with `entry: zone`, a group with a `title`, last;\nwith `id` it changes that row or group: what is absent is left as it is,\nand a change to `pointer`, `note` or a group's `title` names `rev`. A\nnew row's `zone` is the group it goes in. `kind`, and a `zone` that is a\nlane, are refused, and so is every `status` but `needs_input`, which stays\nuntil asks replace it (aru-125: lanes follow the work). The row's\n`pointer` is an issue or a PR (or a link, for a note).",
      "properties": {
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZoneKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refused: a group has no kind."
        },
        "note": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pointer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A row's pointer; `{\"kind\": \"none\"}` clears it."
        },
        "rev": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refused, except `\"needs_input\"`."
        },
        "title": {
          "default": null,
          "description": "A group's title.",
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "default": null,
          "description": "A new row's group (`zon_…`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Row": {
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatAgent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The machine whose agent added the row, if one did (it may remove\nit; nobody else's agent may)."
        },
        "attachments": {
          "default": [],
          "description": "Work and proof attached to the row, oldest first.",
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "block": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockState"
            },
            {
              "type": "null"
            }
          ],
          "description": "A `Block` pointer's block as its machine last reported it, when that\nmachine holds `boards.write` over the board's project."
        },
        "created_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "group": {
          "description": "The group (`zon_…`) the row belongs to, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lane": {
          "$ref": "#/$defs/Lane",
          "default": "next",
          "description": "Where the row is, from the live state of its items."
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/Live"
            },
            {
              "type": "null"
            }
          ],
          "description": "A `fi_`, `iss_` or `run_` pointer's state now, when the reader may see the\nitem ([`BoardView`] is read with it; a write's answer has it too)."
        },
        "marks": {
          "description": "What the lane doesn't say, in a fixed order: `merged_not_closed`,\n`after`, then one `earlier` for each closed block.",
          "items": {
            "$ref": "#/$defs/Mark"
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/Pointer"
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proof"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set only on a Done row that is proven."
        },
        "rev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Kept for old clients; nothing writes it any more (aru-125)."
        },
        "updated_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev",
        "pointer",
        "note",
        "status",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "Status": {
      "description": "Where a row stands. `None` says nothing.",
      "enum": [
        "none",
        "open",
        "working",
        "needs_input",
        "done",
        "failed"
      ],
      "type": "string"
    },
    "WorkItem": {
      "description": "One thing a row may point at.",
      "properties": {
        "assignees": {
          "description": "GitHub logins for a mirrored item; account ids for a native issue.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "identifier": {
          "description": "A tracker item's project key (`ARUGU`).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`issue`, `pr` or `run`.",
          "type": "string"
        },
        "number": {
          "description": "A run has none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pointer": {
          "$ref": "#/$defs/Pointer",
          "description": "What a row takes as its pointer: `Issue`, `ForgeItem` or `Run`."
        },
        "repo": {
          "description": "`OWNER/NAME` of a mirrored item; a tracker project's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "`native`, `github`, `plane` or `run`.",
          "type": "string"
        },
        "state": {
          "description": "`open`, `closed` or `merged` for an issue or a PR; a run's own state.",
          "type": "string"
        },
        "title": {
          "description": "A run's: how it started (`manual run`).",
          "type": "string"
        },
        "updated_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "Where a tracker item is, in the tracker.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pointer",
        "source",
        "kind",
        "title",
        "state",
        "assignees",
        "updated_at"
      ],
      "type": "object"
    },
    "WorkItems": {
      "description": "[`PROJECT_WORK`]'s answer: the newest first, across sources.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/WorkItem"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "items"
      ],
      "type": "object"
    },
    "WorkQuery": {
      "description": "[`PROJECT_WORK`]'s query.",
      "properties": {
        "kind": {
          "default": null,
          "description": "`issue`, `pr` or `run`; absent means all.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "At most this many (default 30, at most 100).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "q": {
          "default": null,
          "description": "Search words: an issue's title or body, a mirrored item's title or\nmirrored content, a run's trigger (`manual`).",
          "type": [
            "string",
            "null"
          ]
        },
        "untriaged": {
          "default": false,
          "description": "Only open issues (native and GitHub) that no row of any of the\nproject's boards points at.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Zone": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZoneKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "rev": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rev",
        "title",
        "rows"
      ],
      "type": "object"
    },
    "ZoneKind": {
      "description": "A zone's kind: every zone a read answers is a `lane`, one of the four\n([`Lane`]). No one makes a zone.",
      "enum": [
        "lane"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "arugula_control_wire::boards"
}

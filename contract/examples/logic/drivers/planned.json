    {
      "about": "chant-fly's apply, as planned",
      "input": {
        "driver": "chant-fly",
        "op": "chant-fly-apply",
        "roll_back": null,
        "settings": {
          "chant_digest": "plan",
          "chant_dir": "ops",
          "chant_env": "github",
          "chant_op": "release",
          "fly_app": "acme-web"
        }
      },
      "output": {"ok": true}
    },
